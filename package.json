{
  "name": "opendesk-browser",
  "version": "0.1.0",
  "private": true,
  "description": "OpenDesk Browser MV3 extension; stage 02A environment",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs production",
    "build:dev": "node scripts/build.mjs development",
    "build:size": "node scripts/audit-fixed-entries.mjs --all",
    "pack": "node scripts/pack.mjs production",
    "pack:dev": "node scripts/pack.mjs development",
    "verify": "node scripts/verify-package.mjs dist/production && node scripts/verify-package.mjs dist/development",
    "check": "node scripts/check-source.mjs",
    "test": "node --test tests/environment/*.test.mjs",
    "dev:chrome": "node scripts/dev-chrome.mjs",
    "build:program": "node scripts/build-program-project.mjs",
    "build:sidebar-tool": "node scripts/build-sidebar-tool.mjs",
    "libs:list": "node scripts/libs.mjs list",
    "libs:check": "node scripts/libs.mjs check",
    "libs:hash": "node scripts/libs.mjs hash",
    "libs:doctor": "node scripts/libs-doctor.mjs",
    "build:market-site": "node scripts/build-market-site.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "terser": "5.34.1",
    "terser-webpack-plugin": "5.6.1",
    "vite": "7.3.6",
    "webpack": "5.111.1",
    "webpack-cli": "5.1.4",
    "wxt": "0.21.4",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "terser": "5.34.1"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "dayjs": "1.11.23",
    "file-saver": "2.0.5",
    "js-cookie": "3.0.8",
    "lodash-es": "4.18.1"
  }
}
