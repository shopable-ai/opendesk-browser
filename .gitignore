# Generated acceptance evidence stays on disk; existing tracked evidence stays tracked.
# Contracts, ledgers and source snapshots outside this directory remain versioned.
/docs/framework/evidence/**

# Session handoff/resume/continue prompts stay local across products, dates and revisions.
# Keep formal GOAL and acceptance contracts versioned.
/docs/framework/prompts/**/*-handoff-*
/docs/framework/prompts/**/*-resume-*
/docs/framework/prompts/**/*-continue-*

# Workstream journals, continuations and run artifacts stay local across all names and dates.
# Keep directories traversable for the fixed inputs below; tracked history stays tracked.
/docs/framework/workstreams/**
!/docs/framework/workstreams/**/

# Fixed framework ledgers/status read by scripts, tests and CI.
!/docs/framework/workstreams/browser-framework-four-layer-ledger.json
!/docs/framework/workstreams/browser-sdk-acceptance.json
!/docs/framework/workstreams/browser-sdk-status.md
!/docs/framework/workstreams/browser-cookies-r6.md

# Fixed JSON contracts read by tests/CI; these paths identify immutable inputs.
!/docs/framework/workstreams/evidence/global-first-r4-20261013/research-evidence.json
!/docs/framework/workstreams/evidence/global-first-r5-20261013/benchmark-contract.json
!/docs/framework/workstreams/evidence/global-first-r5-20261013/source-index.json
!/docs/framework/workstreams/evidence/global-first-r5-20261013/pilot-contract.json

# Actual dependency fixture and ESM project inputs; generated project caches stay local.
!/docs/framework/workstreams/evidence/network-javascript-20261012/browser-05/mustache-cached-source.js
!/docs/framework/workstreams/evidence/network-javascript-20261012/live-esm-project/package.json
!/docs/framework/workstreams/evidence/network-javascript-20261012/live-esm-project/opendesk.remote-lock.json
!/docs/framework/workstreams/evidence/network-javascript-20261012/live-esm-project/src/main.js
!/docs/framework/workstreams/evidence/network-javascript-20261012/live-esm-project/src/values.js
!/docs/framework/workstreams/evidence/network-javascript-20261012/live-esm-project/licenses/d3-array-ISC.txt

# Root-level test runner output; preserve the historical evidence archive.
/evidence/*.tap

# Fixed-tool verification copies/packages/logs; keep summary, binding and hashes.
/evidence/page-import-fixed-tools-*/logs/**
/evidence/page-import-fixed-tools-*/packages/**
/evidence/page-import-fixed-tools-*/*.build-ready.json
/evidence/page-import-fixed-tools-*/*.package.json
/evidence/page-import-fixed-tools-*/*.package-lock.json
/evidence/page-import-fixed-tools-*/copied-files.txt
docs/framework/workstreams/evidence/**

# Generated test output directories; keep test code and fixtures versioned.
/tests/**/evidence/
/tests/**/results/
/tests/**/downloads/

