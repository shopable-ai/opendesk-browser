# Local run logs, process dumps and disposable expected-file copies.
# Keep receipts, source identities, screenshots and raw test results versioned.
/docs/framework/workstreams/evidence/**/*.log
/docs/framework/workstreams/evidence/**/initial-processes.txt
/docs/framework/workstreams/evidence/**/chrome-launcher-*-ps.txt
