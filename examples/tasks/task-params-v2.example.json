{
  "paramsSchemaVersion": 2,
  "paramsSchema": {
    "type": "object",
    "properties": {
      "keyword": {
        "type": "string",
        "title": "关键词",
        "minLength": 1,
        "maxLength": 120,
        "default": "浏览器",
        "description": "填写要匹配的文本。"
      },
      "limit": {
        "type": "integer",
        "title": "最多条数",
        "minimum": 1,
        "maximum": 100,
        "default": 20
      },
      "quality": {
        "type": "integer",
        "title": "匹配阈值",
        "minimum": 0,
        "maximum": 100,
        "multipleOf": 5,
        "default": 80,
        "description": "阈值越高，匹配要求越严格。"
      },
      "format": {
        "type": "string",
        "title": "输出格式",
        "enum": [
          "markdown",
          "json",
          "csv"
        ],
        "default": "markdown"
      },
      "includeLinks": {
        "type": "boolean",
        "title": "附上原文链接",
        "default": true
      },
      "externalOnly": {
        "type": "boolean",
        "title": "仅站外链接",
        "default": false
      },
      "deduplicate": {
        "type": "boolean",
        "title": "自动去重",
        "default": true
      },
      "scope": {
        "type": "string",
        "title": "采集范围",
        "enum": [
          "current",
          "all"
        ],
        "default": "current"
      },
      "contentTypes": {
        "type": "array",
        "title": "内容类型",
        "items": {
          "type": "string",
          "enum": [
            "article",
            "link",
            "image"
          ]
        },
        "uniqueItems": true,
        "default": [
          "article",
          "link"
        ]
      },
      "timeout": {
        "type": "integer",
        "title": "等待秒数",
        "minimum": 1,
        "maximum": 60,
        "default": 10
      },
      "notes": {
        "type": "string",
        "title": "补充说明",
        "maxLength": 500,
        "default": ""
      },
      "startUrl": {
        "type": "string",
        "title": "起始网址",
        "format": "uri",
        "pattern": "^https?://",
        "description": "可选，仅在本脚本需要时使用；不赋予网站访问权限。"
      },
      "since": {
        "type": "string",
        "title": "更新日期",
        "format": "date",
        "description": "可选，仅整理该日期及之后的内容。"
      },
      "afterTime": {
        "type": "string",
        "title": "起始时刻",
        "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "可选，本地钟表时间，不包含时区或定时调度语义。"
      }
    },
    "required": [
      "keyword",
      "limit"
    ],
    "additionalProperties": false
  },
  "paramsUi": {
    "version": 1,
    "order": [
      "keyword",
      "limit",
      "quality",
      "format",
      "includeLinks",
      "externalOnly",
      "deduplicate",
      "scope",
      "contentTypes",
      "timeout",
      "notes",
      "startUrl",
      "since",
      "afterTime"
    ],
    "fields": {
      "keyword": {
        "placeholder": "输入关键词"
      },
      "quality": {
        "widget": "slider",
        "unit": "%"
      },
      "format": {
        "optionLabels": [
          "Markdown",
          "JSON",
          "CSV"
        ]
      },
      "deduplicate": {
        "widget": "switch"
      },
      "scope": {
        "widget": "radio",
        "optionLabels": [
          "当前页",
          "全部页"
        ]
      },
      "contentTypes": {
        "widget": "multi-checkbox",
        "optionLabels": [
          "正文",
          "链接",
          "图片"
        ]
      },
      "notes": {
        "widget": "textarea",
        "placeholder": "输入补充要求"
      },
      "startUrl": {
        "widget": "url",
        "placeholder": "https://example.com"
      },
      "afterTime": {
        "widget": "time"
      }
    }
  }
}
