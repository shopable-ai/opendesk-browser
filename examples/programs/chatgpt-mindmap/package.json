{
  "name": "@opendesk-examples/chatgpt-mindmap",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT per-answer real XMind adapter; runtime admission BLOCKED (see README)",
  "author": "OpenDesk examples",
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.chatgpt-mindmap",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    },
    "assets": [
      {
        "path": "assets/ui.css",
        "kind": "css"
      }
    ]
  }
}
