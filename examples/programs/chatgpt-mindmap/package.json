{
  "name": "@opendesk-examples/ai-reply-mindmap",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "description": "AI 回复思维导图：ChatGPT 单站的 XMind 阅读、定位与导出；正式资源与授权边界见 README",
  "author": "OpenDesk examples",
  "scripts": {
    "prepare:local": "node scripts/prepare-local-resources.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.ai-reply-mindmap",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    },
    "assets": [
      {
        "path": "assets/ui.css",
        "kind": "css"
      }
    ],
    "pageFrames": [
      {"resourceId": "xmind-runtime", "path": "assets/xmind-runtime.js"}
    ]
  }
}
