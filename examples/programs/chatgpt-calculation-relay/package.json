{
  "name": "@opendesk-examples/chatgpt-calculation-relay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "固定版本 Controller Task 的 ChatGPT 双对话计算调用示例；验证状态见 WORKSTREAM.zh-CN.md",
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.chatgpt-calculation-relay",
    "runtimeKind": "controller",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "siteOrigins": [
      "https://chatgpt.com"
    ],
    "permissions": [
      "page.automation",
      "storage.persistent"
    ],
    "deadlineMs": 120000,
    "paramsSchema": {
      "type": "object",
      "properties": {
        "addend": {
          "type": "integer",
          "title": "A 的第一个加数",
          "minimum": -1000000,
          "maximum": 1000000,
          "default": 17
        },
        "runId": {
          "type": "string",
          "title": "运行标识（可选）",
          "minLength": 8,
          "maxLength": 80,
          "description": "8–80 位字母、数字、下划线或连字符；入口校验字符范围"
        },
        "operation": {
          "type": "string",
          "title": "运行、只读状态/网页或显式对账续接",
          "enum": [
            "run",
            "status",
            "inspect",
            "reconcile"
          ]
        },
        "secondAddend": {
          "type": "integer",
          "title": "A 的第二个加数",
          "minimum": -1000000,
          "maximum": 1000000,
          "default": 25
        },
        "multiplier": {
          "type": "integer",
          "title": "B 的乘数",
          "minimum": -1000000,
          "maximum": 1000000,
          "default": 3
        }
      },
      "required": [],
      "additionalProperties": false
    }
  }
}
