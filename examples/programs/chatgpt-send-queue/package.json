{
  "name": "@opendesk-examples/chatgpt-send-queue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conservative, memory-only ChatGPT Send Queue Page USER_SCRIPT",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.chatgpt-send-queue",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    },
    "assets": [
      {
        "path": "assets/queue.css",
        "kind": "css"
      }
    ]
  }
}
