{
  "name": "@opendesk-examples/ai-scroll-navigation",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "AI 对话滚动导航与回顶：ChatGPT、DeepSeek 长回复顶部/底部定位，ChatGPT、DeepSeek、Gemini 对话顶部/底部和悬浮回顶；仅在已授权且明确适配的页面启用。",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.ai-scroll-navigation",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*"
      ],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    }
  }
}
