{
  "name": "@opendesk-examples/chatgpt-jump-top",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT region jump-to-top with sticky-aware positioning",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.chatgpt-jump-top",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": ["https://chatgpt.com/*"],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    }
  }
}
