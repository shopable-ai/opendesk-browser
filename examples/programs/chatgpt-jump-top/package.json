{
  "name": "@opendesk-examples/ai-scroll-navigation",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "AI 对话滚动导航：ChatGPT、DeepSeek 长回复定位，以及 ChatGPT、DeepSeek、Gemini 对话顶部/底部导航；仅在明确适配的页面启用。",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.chatgpt-jump-top",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.deepseek.com/*",
        "https://gemini.google.com/*"
      ],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    }
  }
}
