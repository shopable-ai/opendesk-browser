{
  "name": "@opendesk-examples/local-page-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local multi-file USER_SCRIPT floating UI for explicit preview on authorized HTTP(S) pages",
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "sample.local-page-ui",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": ["*://*/*"],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    },
    "assets": [
      {"path": "assets/ui.css", "kind": "css"},
      {"path": "assets/mark.png", "kind": "image"}
    ]
  }
}
