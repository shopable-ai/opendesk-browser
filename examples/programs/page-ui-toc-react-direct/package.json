{
  "name": "@opendesk-examples/page-ui-toc-react-direct",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "React Direct table of contents with real pinned HTTPS ECharts bar chart",
  "scripts": {
    "test": "node --test src/toc-model.test.mjs src/heading-stats.test.mjs src/heading-chart.test.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "sample.page-ui-toc-react-direct",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "framework": "react",
    "entryMode": "component",
    "pageRules": {
      "matches": ["http://127.0.0.1:43111/*", "http://192.168.30.8:8000/*"],
      "excludeMatches": ["http://127.0.0.1:43111/private/*", "http://192.168.30.8:8000/private/*"],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    },
    "remoteDependencies": {
      "format": "opendesk.remote-dependencies.v1",
      "profile": "page-library-v1",
      "imports": {
        "zrender/": "https://cdn.jsdelivr.net/npm/zrender@5.6.1/",
        "tslib": "https://cdn.jsdelivr.net/npm/tslib@2.3.0/tslib.es6.js"
      }
    }
  }
}
