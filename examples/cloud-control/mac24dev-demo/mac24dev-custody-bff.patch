+test('custody catalog scopes disclosure to the session owner and makes no mutations', async t => {
+  const f = fixture(t);
+  f.binding.executorId = f.scope.executorId = '460154c0-4cec-449a-8075-734d86f7f686';
+  f.scope.result = {body:'private result'};
+  f.writeConfig();
+  const first = (await f.service.catalog({})).devices;
+  assert.deepEqual(Array.from(first, d => d.id), [10]);
+  const detail = JSON.parse(JSON.stringify(first[0].detail));
+  assert.match(detail.checkedAt, /^\d{4}-\d\d-\d\dT/);
+  delete detail.checkedAt;
+  assert.deepEqual(detail, {
+    bindingState:'bound', bindingReason:'BOUND', source:'provider-client-scope',
+    executorSuffix:'f686', transport:'wss', readinessReason:'CONNECTED',
+    tasks:[{taskId:pin.taskId, version:pin.version, siteOrigins:['http://127.0.0.1:43111'], resultAccess:'status-only'}],
+  });
+  const wire = JSON.stringify(first);
+  for (const secret of [f.binding.clientToken, f.binding.clientId, f.binding.grantId,
+    f.binding.bindingId, f.binding.executorId, 'private result']) assert.equal(wire.includes(secret), false);
+
+  f.user.id = f.service.ctx.user.userId = 2;
+  const second = (await f.service.catalog({})).devices;
+  assert.deepEqual(Array.from(second, d => d.id), [20]);
+  assert.equal(second[0].detail.bindingReason, 'UNBOUND');
+  assert.equal(second[0].detail.tasks, undefined);
+  await rejects(f.service.catalog({deviceId:10}), 'E_SCHEMA');
+  assert.deepEqual(f.calls.map(call => call.route), ['/v1/client-scope']);
+  assert.equal(f.rows.size, 0);
+  assert.equal(f.jobs.size, 0);
+});
