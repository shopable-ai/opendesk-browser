+test('custody distinguishes verified pause, scope rejection, offline and unavailable sources', async t => {
+  const f = fixture(t);
+  for (const [state, transport, reason] of [
+    ['READY','wss','CONNECTED'], ['NOT_CONNECTED','none','OFFLINE'],
+    ['NOT_AUTHORIZED','none','PAUSED'], ['NOT_AUTHORIZED','wss','UNCONFIRMED'],
+  ]) {
+    f.scope.availability = {state,transport};
+    const {detail} = (await f.service.catalog({})).devices[0];
+    assert.equal(detail.readinessReason, reason);
+  }
+  f.scope.allowResult = true;
+  delete f.scope.availability;
+  let device = (await f.service.catalog({})).devices[0];
+  assert.equal(device.readiness, 'UNKNOWN');
+  assert.equal(device.detail.readinessReason, 'UNCONFIRMED');
+  assert.equal(device.detail.tasks[0].resultAccess, 'unconfirmed');
+  f.override(() => ({httpStatus:403,body:{error:{code:'E_AUTH',message:f.binding.clientToken}}}));
+  device = (await f.service.catalog({})).devices[0];
+  assert.equal(device.detail.bindingReason, 'SCOPE_UNVERIFIED');
+  assert.equal(device.detail.tasks, undefined);
+  assert.equal(device.detail.readinessReason, undefined);
+  assert.equal(JSON.stringify(device).includes(f.binding.clientToken), false);
+  fs.unlinkSync(f.configFile);
+  device = (await f.service.catalog({})).devices[0];
+  assert.equal(device.detail.bindingReason, 'CONFIG_UNAVAILABLE');
+  assert.equal(device.readiness, 'UNKNOWN');
+});
