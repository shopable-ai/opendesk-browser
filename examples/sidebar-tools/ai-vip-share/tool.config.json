    "js": "dist/tool.js"
  },
  "assets": [],
  "format": "opendesk.sidebar-tool.v2",
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": []
  },
  "uiRuntime": "opendesk.react-ui.v1"
}
