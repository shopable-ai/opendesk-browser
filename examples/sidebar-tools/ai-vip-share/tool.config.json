{
  "id": "ai-vip-share",
  "version": "1.4.15",
  "title": "AI VIP Share",
  "description": "本地 Cookie JSON 预检与网站快速登录；保留会员、激活码和网络服务。Cookie 读权限仅用于核对当前 Store/Partition，不读取现有 Cookie 值。",
  "capabilities": [
    "storage.local",
    "network",
    "browser.tabs",
    "browser.proxy.managed",
    "browser.cookies.write",
    "browser.cookies.read",
    "currentPage.read"
  ],
  "files": {
    "html": "src/index.html",
    "css": "dist/tool.css",
    "js": "dist/tool.js"
  },
  "assets": [],
  "format": "opendesk.sidebar-tool.v2",
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": []
  },
  "uiRuntime": "opendesk.react-ui.v1"
}
