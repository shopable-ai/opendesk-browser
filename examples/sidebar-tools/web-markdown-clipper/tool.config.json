{
  "format": "opendesk.sidebar-tool.v2",
  "id": "web-markdown-clipper",
  "version": "1.2.6",
  "title": "网页剪藏",
  "description": "网页全文剪藏与选区摘录；我的摘录支持长期本地保存、搜索、全文阅读和 Markdown 备份。",
  "capabilities": [
    "page.clip",
    "user.export",
    "storage.local",
    "currentPage.read",
    "browser.contextMenu"
  ],
  "files": {
    "html": "src/index.html",
    "css": "src/style.css",
    "js": "src/main.js",
    "dependencies": [
      "src/notes.js"
    ]
  },
  "assets": [],
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": [
      {
        "actionId": "save-selection",
        "title": "保存选中内容到我的摘录",
        "contexts": [
          "selection"
        ],
        "documentUrlPatterns": [
          "http://*/*",
          "https://*/*"
        ],
        "handler": "open-self"
      }
    ]
  }
}
