{
  "format": "opendesk.sidebar-tool.v2",
  "id": "prompt-shortcuts",
  "version": "1.1.9",
  "title": "提示词快捷按钮",
  "description": "提示词快捷按钮：ChatGPT、DeepSeek、Gemini 对话页默认适配，保留草稿，只插入不发送；其他网站可自定义规则。",
  "capabilities": [
    "storage.local",
    "user.export",
    "page.prompts",
    "browser.contextMenu"
  ],
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": [
      {
        "actionId": "add-selection",
        "title": "添加为提示词快捷按钮",
        "contexts": [
          "selection"
        ],
        "documentUrlPatterns": [
          "https://chatgpt.com/*"
        ],
        "handler": "open-self"
      }
    ]
  },
  "files": {
    "html": "src/index.html",
    "css": "src/style.css",
    "js": "src/main.js",
    "dependencies": [
      "trusted/model.js"
    ]
  },
  "assets": []
}
