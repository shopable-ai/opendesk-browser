{
  "format": "opendesk.sidebar-tool.v2",
  "id": "browser-sdk-acceptance",
  "version": "10.7.0",
  "title": "Browser SDK Acceptance",
  "description": "R10.7 installed-tool acceptance: exercise every approved public SDK method by real clicks, with separate Host and native Chrome evidence gates.",
  "capabilities": [
    "browser.contextMenu",
    "currentPage.read",
    "user.export",
    "browser.bookmarks",
    "browser.storage",
    "browser.scheduler",
    "browser.tabs",
    "browser.sidePanel",
    "network",
    "browser.network.observe",
    "browser.events",
    "browser.operations",
    "browser.screenshot",
    "browser.cookies.read",
    "browser.cookies.values",
    "browser.cookies.write",
    "browser.cookies.observe",
    "browser.cookies.clear"
  ],
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": [
      {
        "actionId": "sdk-check",
        "title": "Open SDK acceptance tool",
        "contexts": [
          "page",
          "selection"
        ],
        "documentUrlPatterns": [
          "http://127.0.0.1/*"
        ],
        "handler": "open-self"
      }
    ]
  },
  "files": {
    "html": "src/index.html",
    "css": "src/style.css",
    "js": "src/main.js"
  },
  "assets": []
}
