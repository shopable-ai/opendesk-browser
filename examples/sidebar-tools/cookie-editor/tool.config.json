{
  "format": "opendesk.sidebar-tool.v2",
  "id": "cookie-editor",
  "version": "2.0.23",
  "title": "Cookie Editor · Cookie 管理",
  "description": "Cookie Editor：保留正式 UI，文本和文件逐条预览新增、覆盖、过期及无效记录，自动分批导入并由 Chrome 原生回读。",
  "capabilities": [
    "currentPage.read",
    "user.export",
    "browser.cookies.read",
    "browser.cookies.values",
    "browser.cookies.write",
    "browser.cookies.observe",
    "browser.cookies.clear"
  ],
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": []
  },
  "files": {
    "html": "src/index.html",
    "css": "src/style.css",
    "js": "src/main.js"
  },
  "assets": []
}
