{
  "format": "opendesk.sidebar-tool.v2",
  "id": "cookie-editor",
  "version": "2.0.43",
  "title": "Cookie Editor · Cookie 管理",
  "description": "Cookie Editor：管理已授权网站的 Cookie，支持原位编辑、复制、下载、导入导出，以及可信加密多账号快照、显式切换和受控 URL 自动切换。",
  "capabilities": [
    "currentPage.read",
    "user.export",
    "browser.cookies.read",
    "browser.cookies.values",
    "browser.cookies.write",
    "browser.cookies.observe",
    "browser.cookies.clear"
  ],
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": []
  },
  "files": {
    "html": "src/root.html",
    "css": "dist/tool.css",
    "js": "dist/tool.js"
  },
  "assets": [],
  "uiRuntime": "opendesk.react-ui.v1"
}
