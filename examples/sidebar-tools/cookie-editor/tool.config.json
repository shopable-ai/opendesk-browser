{
  "format": "opendesk.sidebar-tool.v2",
  "id": "cookie-editor",
  "version": "2.0.0",
  "title": "Cookie Editor · Cookie 管理",
  "description": "通过正式 OpenDesk Browser Cookies SDK，按网站独立授权管理真实 Chrome Cookie；敏感值和更改须独立审阅。保留隔离的离线工作区。",
  "capabilities": [
    "currentPage.read",
    "user.export",
    "browser.cookies.read",
    "browser.cookies.values",
    "browser.cookies.write",
    "browser.cookies.observe",
    "browser.cookies.clear"
  ],
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": []
  },
  "files": {
    "html": "src/index.html",
    "css": "src/style.css",
    "js": "src/main.js"
  },
  "assets": []
}
