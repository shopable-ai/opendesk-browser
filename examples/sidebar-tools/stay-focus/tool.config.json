{
  "id": "stay-focus",
  "version": "1.0.8",
  "title": "Stay Focus · 保持专注",
  "description": "本机娱乐限额、共享时间预算、工作时段和专注模式；由 Chrome 在得到独立授权后限制网站访问。",
  "capabilities": [
    "focus.control",
    "currentPage.read"
  ],
  "files": {
    "html": "src/index.html",
    "css": "dist/tool.css",
    "js": "dist/tool.js"
  },
  "assets": [],
  "backgroundPolicy": {
    "kind": "site-budget.v2",
    "dailyMinutes": 30,
    "defaultSites": [
      "youtube.com",
      "bilibili.com",
      "tiktok.com",
      "douyin.com",
      "instagram.com",
      "reddit.com",
      "x.com",
      "weibo.com",
      "netflix.com",
      "twitch.tv",
      "roblox.com",
      "pinterest.com"
    ],
    "schedule": {
      "enabled": false,
      "days": [
        1,
        2,
        3,
        4,
        5
      ],
      "startMinute": 540,
      "endMinute": 1020
    },
    "suggestions": [
