{
  "name": "scrapyjs",
  "description": "> 原则：简单使用，简化重复代码。罗列出不同变化频率的变量。包含导出文件格式，",
  "version": "1.0.0",
  "main": "dist/scrapyJs.node.cjs",
  "exports": {
    ".": "./dist/scrapyJs.node.cjs",
    "./browser": "./dist/scrapyJs.js"
  },
  "files": [
    "dist/scrapyJs.node.cjs",
    "dist/scrapyJs.js",
    "examples/douban-books/*.cjs",
    "examples/douban-books/README.md",
    "examples/csdn-columns/*.cjs",
    "examples/csdn-columns/README.md",
    "examples/browser-modules.cjs",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_LICENSES.txt",
    "docs/node-package-usage.md",
    "docs/examples-public-api-delivery.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "lint": "node test/lint.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm pack --dry-run",
    "build": "webpack --config webpack.config.js",
    "gulp": "gulp scripts",
    "build:node": "node scripts/build-node.cjs",
    "build:all": "node scripts/build-all.cjs",
    "prepack": "npm run build:all",
    "check:artifacts": "node scripts/check-artifacts.cjs",
    "verify:examples": "node scripts/verify-examples.cjs",
    "test:consumer": "node scripts/consumer-smoke.cjs",
    "recipe:create": "node tools/recipe-factory/cli.cjs create",
    "recipe:verify": "node tools/recipe-factory/cli.cjs verify",
    "recipe:run": "node tools/recipe-factory/cli.cjs run",
    "recipe:build": "node tools/recipe-factory/cli.cjs build",
    "recipe:test": "node --test test/recipe-factory.test.cjs ../scrapyJsChrome/test/recipe-contract.test.cjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "ansi-regex": "^2.1.1",
    "ansi-styles": "^2.2.1",
    "axios": "^1.8.2",
    "camelcase": "^2.1.1",
    "chalk": "^1.1.3",
    "cheerio": "1.0.0",
    "cliui": "^3.2.0",
    "code-point-at": "^1.1.0",
    "commander": "^2.20.3",
    "concat": "^1.0.3",
    "concat-cli": "^4.0.0",
    "decamelize": "^1.2.0",
    "escape-string-regexp": "^1.0.5",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "has-ansi": "^2.0.0",
    "invert-kv": "^1.0.0",
    "is-fullwidth-code-point": "^1.0.0",
    "lcid": "^1.0.0",
    "number-is-nan": "^1.0.1",
    "os-locale": "^1.4.0",
    "string-width": "^1.0.2",
    "strip-ansi": "^3.0.1",
    "supports-color": "^2.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^4.1.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "window-size": "^0.1.4",
    "wrap-ansi": "^2.1.0",
    "y18n": "^3.2.2",
    "yargs": "^3.32.0"
  },
  "keywords": [
    "scrapy"
  ],
  "author": "",
  "license": "ISC",
  "bin": {
    "scrapyjs-douban": "examples/douban-books/run.cjs",
    "scrapyjs-csdn-columns": "examples/csdn-columns/run.cjs"
  }
}
