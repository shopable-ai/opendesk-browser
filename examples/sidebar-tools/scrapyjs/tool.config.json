{
  "format": "opendesk.sidebar-tool.v2",
  "id": "scrapyjs",
  "version": "1.8.16",
  "title": "scrapyjs 采集",
  "description": "用已有或手填声明式规则进行本机试采，核对后确认持久采集；可选 AI 生成或纠正规则，保留原浏览器采集与导出。",
  "capabilities": [
    "ai.generate",
    "localTasks",
    "storage.local",
    "currentPage.read",
    "user.export",
    "tasks.run",
    "controllers.run"
  ],
  "files": {
    "html": "src/index.html",
    "css": "dist/tool.css",
    "js": "dist/tool.js",
    "dependencies": [
      "adapters/app-sdk.js",
      "src/app-model.js"
    ],
    "controller": "dist/controller.js"
  },
  "requires": {
    "browserSdk": "1.0.0"
  },
  "contributes": {
    "contextMenus": []
  },
  "delegatedTasks": [
    {
      "taskId": "scrapyjs.capture",
      "version": "0.6.2",
      "manifestHash": "d525c95c51d6c698468a05b5a33a8d033f1ff21e37fdbea95e1dc722bb4a1385",
      "contentHash": "2912f8f85b8fba80260e945f37317d73c1b3942f882f95092ea967fed16e9331"
    }
  ],
  "uiRuntime": "opendesk.react-ui.v1",
  "controller": {
    "siteOrigins": [
      "http://127.0.0.1:43111",
      "https://book.douban.com",
      "https://download.csdn.net"
    ],
    "permissions": [
      "page.automation"
    ],
    "paramsSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "configJson"
      ],
      "properties": {
        "url": {
          "type": "string",
          "title": "网页地址",
          "maxLength": 2048
        },
        "configJson": {
          "type": "string",
          "title": "选择器配置 JSON",
          "maxLength": 4096
        },
        "waitForSelector": {
          "type": "string",
          "title": "等待选择器",
          "maxLength": 1024,
          "default": "#sample-list li"
        },
        "timeoutMs": {
          "type": "integer",
          "title": "等待上限（毫秒）",
          "minimum": 1,
          "maximum": 60000,
          "default": 30000
        },
        "optionsJson": {
          "type": "string",
          "title": "分页、详情与处理配置 JSON",
          "maxLength": 4096,
          "default": "{}"
        }
      }
    },
    "deadlineMs": 90000,
    "builtinIdentity": {
      "abi": "opendesk-builtins.v10",
      "catalogSha256": "085e98aaa50e60a734671ec3e99b16cd909bc5336dd6f7585a8be9ae0e394c0f",
      "bundleSha256": "78012cedf6b9711a6bbb719914ce80e36c6e536ed13139dd1b1b3b4979b12db0"
    }
  }
}
