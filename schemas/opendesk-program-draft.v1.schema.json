{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDesk Browser program draft import envelope",
  "type": "object",
  "required": ["format", "project", "runtimeKind", "build", "sourceUtf8", "authoring"],
  "properties": {
    "format": {"const": "opendesk.program-draft.v1"},
    "project": {
      "type": "object",
      "required": ["id", "version", "entry"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,59}$"},
        "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"},
        "entry": {"type": "string", "minLength": 4, "maxLength": 240}
      },
      "additionalProperties": false
    },
    "runtimeKind": {"enum": ["controller", "page-userscript"]},
    "build": {
      "type": "object",
      "required": ["mode", "sourceHash", "byteLength"],
      "properties": {
        "mode": {"enum": ["production", "development"]},
        "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "byteLength": {"type": "integer", "minimum": 1, "maximum": 100000}
      },
      "additionalProperties": false
    },
    "sourceUtf8": {"type": "string", "minLength": 1, "maxLength": 100000},
    "authoring": {
      "type": "object",
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": ["path", "sourceUtf8", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1, "maxLength": 240},
              "sourceUtf8": {"type": "string", "minLength": 1, "maxLength": 256000},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
