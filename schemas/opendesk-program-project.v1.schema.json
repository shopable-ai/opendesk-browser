{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDesk Browser ESM project source manifest (not an installable package)",
  "type": "object",
  "required": [
    "name",
    "version",
    "type",
    "private",
    "description",
    "opendesk"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "type": {
      "const": "module"
    },
    "private": {
      "const": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "opendesk": {
      "oneOf": [
        {
          "$ref": "#/$defs/page"
        },
        {
          "$ref": "#/$defs/controller"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "common": {
      "type": "object",
      "properties": {
        "format": {
          "const": "opendesk.project.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,59}$"
        },
        "runtimeKind": {
          "enum": [
            "page-userscript",
            "controller"
          ]
        },
        "sourceFormat": {
          "const": "esm"
        },
        "entry": {
          "type": "string",
          "minLength": 4
        },
        "assets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "required": [
              "path",
              "kind"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "css",
                  "json",
                  "image"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "format",
        "id",
        "runtimeKind",
        "sourceFormat",
        "entry"
      ]
    },
    "page": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "runtimeKind": {
              "const": "page-userscript"
            },
            "framework": {"enum": ["react", "vue"]},
            "entryMode": {"const": "component"},
            "pageFrames": {
              "description": "Frozen project-local, precompiled self-contained .js frame resources; at most 5 MiB each and 6 MiB combined, with no runtime imports.",
              "type": "array",
              "maxItems": 4,
              "items": {
                "type": "object",
                "required": ["resourceId", "path"],
                "properties": {
                  "resourceId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,79}$"},
                  "path": {
                    "type": "string",
                    "maxLength": 240,
                    "pattern": "^[A-Za-z0-9@][A-Za-z0-9@._/-]*\\.js$",
                    "not": {"pattern": "(?:^|/)(?:\\.\\.?|node_modules|\\.git)(?:/|$)|//"}
                  }
                },
                "additionalProperties": false
              }
            },
            "pageRules": {
              "type": "object",
              "required": [
                "matches",
                "excludeMatches",
                "runAt",
                "allFrames",
                "world"
              ],
              "properties": {
                "matches": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "excludeMatches": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "runAt": {
                  "enum": [
                    "document_start",
                    "document_end",
                    "document_idle"
                  ]
                },
                "allFrames": {
                  "type": "boolean"
                },
                "world": {
                  "const": "USER_SCRIPT"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "pageRules"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "controller": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "properties": {
            "runtimeKind": {
              "const": "controller"
            },
            "siteOrigins": {
              "description": "One exact HTTP(S) origin, or <all_urls> for local development on all HTTP(S) sites. Installed Tasks require a site-specific review.",
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "string"
              }
            },
            "permissions": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "page.automation"
                },
                {
                  "const": "storage.persistent"
                }
              ],
              "minItems": 1,
              "maxItems": 2,
              "items": false
            },
            "paramsSchema": {
              "type": "object"
            },
            "deadlineMs": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 120000
            }
          },
          "required": [
            "siteOrigins",
            "permissions",
            "paramsSchema"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
