{
  "name": "@opendesk/subagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Subagent 独立网页增强产品；Mini Chat 是第一阶段验证 A→B→A 的轻量 Demo，执行复用受审 WebFlow Controller Task",
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "opendesk": {
    "format": "opendesk.project.v1",
    "id": "opendesk.subagent",
    "runtimeKind": "page-userscript",
    "sourceFormat": "esm",
    "entry": "src/main.js",
    "pageRules": {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "excludeMatches": [],
      "runAt": "document_idle",
      "allFrames": false,
      "world": "USER_SCRIPT"
    }
  }
}
