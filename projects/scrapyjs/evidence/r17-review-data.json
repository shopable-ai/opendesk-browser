  "findings": [
    {
      "id": "R17-DATA-001",
      "priority": 1,
      "severity": "HIGH",
      "title": "Scrapling CSS scope can read a different row and miss valid ancestor-qualified fields",
      "location": {
        "path": "examples/sidebar-tools/scrapyjs/local-runner/scrapyjs_runner/dsl.py",
        "startLine": 124,
        "endLine": 128
      },
      "status": "REPRODUCED_LOCAL_REAL_SCRAPLING",
      "rootCause": "Filtering out context._root does not implement Element.querySelectorAll. Scrapling CSS can traverse following siblings outside the row, while selector chains that need ancestors outside the row fail. At document level the same filter also removes the html element, which a browser Document query can select.",
      "reproductions": [
        {
          "html": "<ul><li id=\"a\">A</li><li id=\"b\">B</li></ul>",
          "itemConfig": {
            "_listContainer": "ul",
            "_listItem": "li",
            "id": ".::id",
            "v": "li + li::text",
            "v2": "li ~ li::text"
          },
          "actual": [
            {
              "id": "a",
              "v": "B",
              "v2": "B"
            },
            {
              "id": "b",
              "v": "",
              "v2": ""
            }
          ],
          "expectedFields": [
            {
              "v": "",
              "v2": ""
            },
            {
              "v": "",
              "v2": ""
            }
          ],
          "reference": "Original extractRecords executed in a linkedom DOM returns empty v/v2 in both rows. The . extension is not required to reproduce the leaking fields."
        },
        {
          "html": "<html><body><ul><li><b>A</b></li><li><b>B</b></li></ul><p>P</p></body></html>",
          "itemConfig": {
            "_listContainer": "ul",
            "_listItem": "li",
            "v": "ul li b::text"
          },
          "actual": [
            {
              "v": ""
            },
            {
              "v": ""
            }
          ],
          "expected": [
            {
              "v": "A"
            },
            {
              "v": "B"
            }
          ],
          "reference": "Original normalizeConfig + extractRecords executed in a linkedom DOM."
        },
        {
          "html": "<html lang=\"en\"><body><p>P</p></body></html>",
          "itemConfig": {
            "html": "html::lang",
            "body": "body::text"
          },
          "actual": [
            {
              "html": "",
              "body": "P"
            }
          ],
          "expected": [
            {
              "html": "en",
              "body": "P"
            }
          ],
          "reference": "Original normalizeConfig + extractRecords executed in a linkedom DOM."
        }
      ],
      "referenceLocations": [
        {
          "path": "examples/sidebar-tools/scrapyjs/vendor/scrapyjs/src/item/item-loader-extraction.js",
          "startLine": 95,
          "endLine": 99
        }
      ],
      "impact": "Supported CSS can silently cross-contaminate records or report present values as missing. It can also affect waitForSelector and list containers that select the document html root.",
      "recommendation": "Preserve the distinction between Document queries and row-element queries; implement descendant containment with browser-equivalent matching rather than only excluding the context node. Add sibling, external-ancestor and html-root cases.",
      "notClaimed": "No real Chrome querySelectorAll comparison was run; the browser semantics reference here is the retained implementation executing in linkedom."
    },
    {
      "id": "R17-DATA-002",
      "priority": 1,
      "severity": "HIGH",
      "title": "Relative pagination ignores the page's base href and can commit data from the wrong URL",
      "location": {
        "path": "examples/sidebar-tools/scrapyjs/local-runner/scrapyjs_runner/worker.py",
        "startLine": 63,
        "endLine": 66
      },
      "status": "REPRODUCED_LOCAL_WORKER_COMPONENT",
      "rootCause": "The next link is always resolved against final_url; the HTML base element is never applied.",
      "reproduction": {
        "config": {
          "url": "https://example.org/list",
          "itemConfig": {
            "_listContainer": "ul",
            "_listItem": "li",
            "id": "b::text",
            "name": "p::text"
          },
          "nextPageSelector": "a.next",
          "maxPages": 3
        },
        "firstPageHtml": "<base href=\"/catalog/\"><ul><li><b>1</b><p>FIRST</p></li></ul><a class=\"next\" href=\"2\">Next</a>",
        "finalUrl": "https://example.org/list",
        "expectedNextUrl": "https://example.org/catalog/2",
        "actualNextUrl": "https://example.org/2",
        "actualRecords": [
          {
            "id": "1",
            "name": "FIRST"
          },
          {
            "id": "WRONG",
            "name": "wrong page"
          }
        ],
        "outcome": {
          "status": "COMPLETED",
          "stopReason": "NO_NEXT_PAGE",
          "errors": []
        }
      },
      "referenceLocations": [
        {
          "path": "examples/sidebar-tools/scrapyjs/vendor/scrapyjs/src/core/ChromeSpider.js",
          "startLine": 257,
          "endLine": 264
        }
      ],
      "impact": "A relative next link can silently visit a different in-scope document and report its records as a successful crawl.",
      "recommendation": "Resolve the first applicable base href against the final response URL, then resolve the next href against that document base and apply the existing scope validation to the resulting URL.",
      "evidenceLimit": "Real run_worker and real Scrapling parsing were exercised; downloader responses and Store were in-memory doubles. No HTTP server, actual redirect or real network was exercised."
    },
    {
      "id": "R17-DATA-003",
      "priority": 1,
      "severity": "HIGH",
      "title": "A redirect to an already visited document is extracted and persisted before pagination-loop detection",
      "location": {
        "path": "examples/sidebar-tools/scrapyjs/local-runner/scrapyjs_runner/worker.py",
        "startLine": 38,
        "endLine": 42
      },
      "relatedLocations": [
        {
          "path": "examples/sidebar-tools/scrapyjs/local-runner/scrapyjs_runner/worker.py",
          "startLine": 55,
          "endLine": 67
        }
      ],
      "status": "REPRODUCED_LOCAL_WORKER_COMPONENT",
      "rootCause": "seen_pages contains requested URLs only. The final_url returned by the downloader is not checked or recorded before extract/commit_page.",
      "reproduction": {
        "seedUrl": "https://example.org/list",
        "firstPage": "<ul><li><b>1</b><p>FIRST</p></li></ul><a class=\"next\" href=\"/alias\">Next</a>",
        "secondRequest": "https://example.org/alias",
        "secondResponseFinalUrl": "https://example.org/list",
        "secondResponseHtml": "same as firstPage",
        "expected": "Stop before a second commit when the final document URL was already visited.",
        "actualRecords": [
          {
            "id": "1",
            "name": "FIRST"
          },
          {
            "id": "1",
            "name": "FIRST"
          }
        ],
        "actualPagesVisited": 2,
        "actualOutcome": {
          "status": "FAILED",
          "stopReason": "PAGINATION_LOOP",
          "errors": [
            {
              "code": "PAGINATION_LOOP",
              "message": "PAGINATION_LOOP"
            }
          ]
        }
      },
      "impact": "The loop is eventually reported, but retained records, exports and completeness already contain a duplicate page. dedupeKey is optional and cannot repair page-count correctness.",
      "recommendation": "Check and register the final response document URL before extraction/commit while handling the normal case final_url == current requested URL correctly. Keep existing loop and scope protections.",
      "evidenceLimit": "The returned redirect target was supplied by a canned downloader. The worker's behavior for that returned URL is proven; actual HTTP redirect handling remains NOT_TESTED."
    },
    {
      "id": "R17-DATA-004",
      "priority": 2,
      "severity": "MEDIUM",
      "title": "A valid nested field named selector is incorrectly classified as a descriptor",
      "location": {
        "path": "examples/sidebar-tools/scrapyjs/local-runner/scrapyjs_runner/dsl.py",
        "startLine": 99,
        "endLine": 100
      },
      "status": "REPRODUCED_LOCAL_REAL_SCRAPLING_AND_ORIGINAL_DSL",
      "rootCause": "compile_config uses only the presence of a selector key to distinguish descriptors from nested objects. The original DSL requires that key's value to be a string.",
      "reproduction": {
        "html": "<html><body><ul><li><b>A</b></li><li><b>B</b></li></ul><p>P</p></body></html>",
        "itemConfig": {
          "meta": {
            "selector": {
              "selector": "b",
              "read": "text"
            },
            "value": "p"
          }
        },
        "expected": [
          {
            "meta": {
              "selector": [
                "A",
                "B"
              ],
              "value": "P"
            }
          }
        ],
        "actual": {
          "error": "NOT_SUPPORTED",
          "message": "Unknown field descriptor property"
        }
      },
      "referenceLocations": [
        {
          "path": "examples/sidebar-tools/scrapyjs/vendor/scrapyjs/src/item/item-loader-extraction.js",
          "startLine": 70,
          "endLine": 76
        }
      ],
      "impact": "Existing valid nested configurations are rejected instead of preserving their object/list shape.",
      "recommendation": "Use the original descriptor-versus-nested discriminator, including the string type check, while retaining normal descriptor validation."
    },
    {
      "id": "R17-DATA-005",
      "priority": 2,
      "severity": "MEDIUM",
      "title": "Static disabled next links using existing supported disabled classes are treated as live pagination",
      "location": {
        "path": "examples/sidebar-tools/scrapyjs/local-runner/scrapyjs_runner/worker.py",
        "startLine": 58,
        "endLine": 59
      },
      "status": "REPRODUCED_LOCAL_WORKER_COMPONENT",
      "rootCause": "The filter recognizes disabled but omits is-disabled and ant-pagination-disabled, both handled by the retained pagination source and both observable from static HTML.",
      "reproduction": {
        "url": "https://example.org/list",
        "html": "<ul><li><b>1</b><p>FIRST</p></li></ul><a class=\"next is-disabled\" href=\"/list\">Next</a>",
        "nextPageSelector": "a.next",
        "expected": {
          "status": "COMPLETED",
          "stopReason": "NO_NEXT_PAGE",
          "recordsCount": 1
        },
        "actual": {
          "status": "FAILED",
          "stopReason": "PAGINATION_LOOP",
          "recordsCount": 1
        }
      },
      "referenceLocations": [
        {
          "path": "examples/sidebar-tools/scrapyjs/vendor/scrapyjs/src/core/ChromeSpider.js",
          "startLine": 179,
          "endLine": 184
        }
      ],
      "impact": "A normal final page is presented as a failed run; disabled controls with a different href can trigger an unnecessary next request.",
      "recommendation": "Preserve the existing statically observable disabled classes. Do not claim computed-style/JS disabled-state equivalence without browser evidence.",
      "evidenceLimit": "is-disabled was executed in the worker harness; omission of ant-pagination-disabled was confirmed by source comparison, not a separate executed case."
    }
  ],
