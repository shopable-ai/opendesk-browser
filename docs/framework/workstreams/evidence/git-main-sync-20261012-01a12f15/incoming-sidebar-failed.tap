      '  if(response?.then) {response.then(sendResponse);return true;}\n' +
      '  if(response)sendResponse(response);\n' +
      '  return false;\n' +
      '};\n' +
      'chrome.runtime.onMessage.addListener(draftImportListener);draftImportAttached=true;\n' +
      '/* The same authorized tool.html can be opened in a full Chrome tab.\n' +
