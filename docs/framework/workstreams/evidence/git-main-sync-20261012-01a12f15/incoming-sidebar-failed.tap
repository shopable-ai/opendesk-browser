      '\n' +
      "// An extension's Side Panel and its full-size catalog share tool.html.\n" +
      '// Chrome can expose a tab-like current context in some builds; classify the\n' +
      '// exact current document positively before choosing the catalog-only UI.\n' +
      '// Match the full hostInstanceId URL, not just the extension origin/path.\n' +
      'export async function isActualSidePanelContext({api,href}={}){\n' +
      "  if(!api?.runtime?.getContexts||typeof href!=='string'||!href)return false;\n" +
      '  try{\n' +
      '    const contexts=await api.runtime.getContexts({\n' +
      "      contextTypes:['SIDE_PANEL'],documentUrls:[href]\n" +
      '    });\n' +
      '    return Array.isArray(contexts)&&contexts.some(row=>\n' +
      "      row?.contextType==='SIDE_PANEL'&&row.documentUrl===href&&\n" +
      "      typeof row.documentId==='string'&&row.documentId.length>0);\n" +
      '  }catch{return false;}\n' +
      '}\n' +
      '\n' +
      '// A source-only UI handoff. It never grants permissions, saves or starts a run.\n' +
      'export function receiveSidebarDraft({message,sender,windowId,sidebarSurface,api,receiveDraft}) {\n' +
      "  if(message?.protocol!=='opendesk.sidebar.draft-import.v1' || !sidebarSurface ||\n" +
      '    sender?.id!==api.runtime.id || !sender.tab || sender.tab.incognito ||\n' +
      '    !Number.isSafeInteger(windowId) || sender.tab.windowId!==windowId)return;\n' +
      '  try {\n' +
      "    const sourceUrl=new URL(sender.url),toolUrl=new URL(api.runtime.getURL('ui/tool.html'));\n" +
      '    if(sourceUrl.protocol!==toolUrl.protocol || sourceUrl.host!==toolUrl.host || sourceUrl.pathname!==toolUrl.pathname)return;\n' +
      '    const applied = receiveDraft(message.draft ?? message.sourceUtf8);\n' +
      '    if (applied?.then) return applied.then(() => ({ok:true}),error =>\n' +
      "      ({ok:false,error:{code:error.code || 'E_DRAFT_IMPORT',message:error.message || String(error)}}));\n" +
      '    return {ok:true};\n' +
      "  }catch(error){return {ok:false,error:{code:error.code || 'E_DRAFT_IMPORT',message:error.message || String(error)}};}\n" +
      '}\n' +
      '\n' +
      'export function initToolShell(installDevelopment=null,{debugEnabled=false}={}) {\n' +
      '  const hostUrl = new URL(location.href);\n' +
      "  const hostInstanceId = hostUrl.searchParams.get('hostInstanceId');\n" +
      '  if (!hostInstanceId) {\n' +
      '    // Commit a new sender identity, preserving only a validated installed-tool\n' +
      '    // locator. Clearing all search parameters used to erase toolId on first load.\n' +
      '    location.replace(canonicalToolHostUrl(hostUrl.href,crypto.randomUUID()));\n' +
      '    return;\n' +
      '  }\n' +
      '  const foundationClient = createHostClient(chrome, {hostInstanceId});\n' +
      'const currentPageTarget = createCurrentPageTarget({api:chrome});\n' +
      'const scriptEditor = createScriptEditor({client:foundationClient,currentPageTarget,development:Boolean(installDevelopment)});\n' +
      'let debugWorkbench=null;\n' +
      "// The full-size tool/catalog page must never overwrite the Side Panel's last tab.\n" +
      'const tabMemory=createSidebarTabMemory({\n' +
      '  storage:chrome.storage.local,\n' +
      '  debugEnabled,\n' +
      '  getActiveTab:()=>document.documentElement.dataset.opendeskTab,\n' +
      '  selectTab:view=>taskWorkbench.navigate(view),\n' +
      "  onError:error=>console.warn('Sidebar tab preference unavailable',error)\n" +
      '});\n' +
      'const taskWorkbench = createTaskWorkbench({client:foundationClient,host:scriptEditor.host,currentPageTarget,\n' +
      '  importDraft:sourceUtf8=>scriptEditor.importDraft(sourceUtf8),executionSource:scriptEditor.executionSource,\n' +
      "  debugEnabled,onNavigate:view=>{if(view==='debug')void debugWorkbench?.refresh();},\n" +
      '  onTabSelected:(view,options)=>tabMemory.record(view,options)});\n' +
      'const workflowView=createWorkflowView({api:chrome,client:foundationClient,host:scriptEditor.host,currentPageTarget,\n' +
      '  onRunOwner:id=>taskWorkbench.setWorkflowRunOwner(id),\n' +
      '  openDeveloper:sourceUtf8=>taskWorkbench.receiveDraft(sourceUtf8),\n' +
      "  openCatalog:()=>taskWorkbench.navigate('catalog')});\n" +
      'const sidebarTools=createSidebarTools({api:chrome,currentPageTarget,taskWorkbench});\n' +
      'const installedPageTools=createInstalledPageTools({client:foundationClient,api:chrome,doc:document});\n' +
      '// A full catalog/tool tab also loads tool.html. It must never become a second\n' +
      "// cloud-claiming Host merely because the extension's trusted UI is open.\n" +
      'let cloudHosting=null;\n' +
      'debugWorkbench=debugEnabled?createDebugWorkbench({client:foundationClient,host:scriptEditor.host}):null;\n' +
      "window.addEventListener('pagehide',()=>cloudHosting?.dispose(),{once:true});\n" +
      'taskWorkbench.connectToolsView((visible,destination)=>{\n' +
      '  const accepted=sidebarTools.setVisible(visible,destination);\n' +
      '  if(visible)void installedPageTools.refresh();\n' +
      '  return accepted;\n' +
      '});\n' +
      "const pageRefresh=document.getElementById('installed-page-tools-refresh');\n" +
      "pageRefresh?.addEventListener('click',()=>void installedPageTools.refresh());\n" +
      'const nativeAgentHost=createNativeAgentHostAdapter({client:foundationClient,host:scriptEditor.host,currentPageTarget});\n' +
      'scriptEditor.connectLocalProjects(nativeAgentHost,{onInstalled:({kind,id})=>{\n' +
      "  if(kind==='controller'){\n" +
