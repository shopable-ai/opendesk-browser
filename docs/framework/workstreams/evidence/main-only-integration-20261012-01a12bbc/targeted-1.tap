pace-dock{flex:none;background:#fff;border-top:1px solid var(--line);padding:8px 11px 10px}\n.dock-actions[hidden]{display:none!important}\n.dock-buttons{display:flex;align-items:stretch;gap:8px}\n.dock-buttons button{min-height:38px;padding:8px 10px;border-radius:var(--radius-control);font-size:12px;font-weight:700}\n/* Cross-view running actions belong only to the active RunHost owner. */\n.workspace-dock[data-stop-only="true"] .dock-buttons > :not(#task-stop):not(#script-stop):not(#workflow-stop){display:none}\n.workspace-dock[data-stop-only="true"] .dock-buttons > #task-stop,\n.workspace-dock[data-stop-only="true"] .dock-buttons > #script-stop,\n.workspace-dock[data-stop-only="true"] .dock-buttons > #workflow-stop{flex:1 1 auto}\n#task-run,#script-run,#workflow-run{background:var(--blue);color:#fff;flex:1;border:1px solid var(--blue)}\n#task-stop,#script-stop,#script-save,#workflow-save,#workflow-stop{flex:none;background:#f7f9fd;color:#435873;border:1px solid #d6dfed}\n#task-stop:disabled,#script-stop:disabled,#workflow-stop:disabled{display:none}\n\n/* Installed tasks: one compact list, detail/params inside the selected row. */\n.task-card-list{display:grid;gap:8px;margin:0}\n.task-card-group{min-width:0;background:#fff;border:1px solid var(--line);border-radius:var(--radius-surface);overflow:hidden}\n.task-card-group.selected{border-color:#aac0f4;box-shadow:0 0 0 1px #e7eeff}\n.task-card{display:flex;align-items:center;text-align:left;gap:10px;width:100%;min-height:64px;padding:10px 12px!important;color:var(--ink)!important;background:transparent!important;border:0!important;border-radius:0!important}\n.task-card:hover{background:#fafcff!important}\n.task-card:focus-visible{outline-offset:-3px}\n.task-card-icon{display:grid;place-items:center;flex:none;width:32px;height:32px;border-radius:var(--radius-control);background:#eef3ff;color:#365fbd;font-size:14px;font-weight:750}\n.task-card-copy{flex:1;min-width:0}\n.task-card-copy strong{display:block;font-size:13px;font-weight:700;line-height:1.4;overflow-wrap:anywhere}\n.task-card-copy small{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;color:#64768d;font-size:11px;line-height:1.45;margin-top:3px}\n.task-card-state,.local-discovery-state{flex:none;color:#805b19;background:#fbf1df;border-radius:var(--radius-pill);padding:3px 7px;font-size:11px;white-space:nowrap}\n.task-card-state:empty,.local-discovery-state:empty{display:none}\n.task-card-state:not(.off):not(:empty){background:#e6f5ef;color:#176f54}\n.task-selected-workspace{min-width:0;border-top:1px solid #e9eef5;padding:11px 12px 12px;background:#fff}\n#task-current-site{margin:0 0 5px;font:11px/1.4 system-ui,sans-serif;font-weight:650;color:#15724e}\n#task-current-site[data-state=unmatched],#task-current-site[data-state=unavailable]{color:#a4424e}\n#task-params-form{min-width:0;margin:4px 0 7px}\n#task-params-form:empty{display:none}\n#task-params-form label{font-weight:650;font-size:12px;margin:7px 0 4px}\n#task-params-form .hint{font-size:11px;font-weight:400;margin:3px 0}\n#task-params-form input[type=checkbox]{width:auto;min-height:0}\n#task-params-form select{width:100%}\n#task-status{font-size:12px;line-height:1.45;color:#405c80;background:#f2f6ff;border-radius:var(--radius-control);padding:7px 8px;margin:5px 0}\n#task-status:empty{display:none}\n.task-result-panel{border-top:1px solid #edf0f7;margin-top:8px;padding-top:8px}\n.task-result-heading{margin:0 0 4px;font-size:11px;font-weight:700;color:#526685}\n.task-result-controls,.result-toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;min-width:0}\n#task-result-reveal,.task-result-reveal,#script-copy-result{flex:none;min-height:30px;padding:5px 8px;border:1px solid #cfdaea;background:#f2f6fd;color:#365273;font-size:11px}\n.task-result-reveal{margin:0 0 8px}\n.result-history{border-top:1px solid #e6edf5;padding-top:9px;margin-top:9px}\n.result-history>summary{font-size:11px;font-weight:650}\n.result-toolbar{margin-bottom:6px}\n.result-toolbar .hint{margin:0;color:#526685;font-size:11px}\n.result-toolbar button:disabled{opacity:.5}\n#task-result{margin:0;max-height:160px;border:1px solid #e8edf4;background:#f7f9fc}\n.task-history-panel,.task-scope-panel,.task-tools{border-top:1px solid #edf0f5;margin:8px 0 0;padding-top:7px}\n.task-history-panel>summary,.task-scope-panel>summary,.task-tools>summary{font-size:11px;font-weight:650;color:#476180}\n#task-installed-detail{white-space:pre-wrap;overflow-wrap:anywhere;font-size:11px;line-height:1.6;color:#526784;margin:8px 0 0}\n.task-history-entries{display:grid;gap:6px;margin:8px 0}\n.task-history-entry{border:1px solid #e6edf5;background:#fcfdff;border-radius:var(--radius-control);padding:0 8px;min-width:0}\n.task-history-entry>summary{padding:8px 0;font-size:11px;font-weight:650}\n.task-history-entry pre{margin:0 0 7px;max-height:140px}\n.task-history-tech{font-size:10px}\n.task-history-tech summary{font-size:10px}\n#task-history{overflow-wrap:anywhere;font-size:11px}\n.task-tools .row{margin:7px 0}\n.task-tools .row button{background:#eff3fb;color:#365273;border:1px solid #dce4f0;font-size:11px;min-height:33px}\n.task-tools details{margin:6px 0}\n.task-tools .hint{font-size:11px;line-height:1.45}\n.catalog-open{background:#eef3ff!important;color:#3657a7!important}\n.task-card-list>.hint{background:#fff;border:1px dashed var(--line);padding:16px 12px;border-radius:var(--radius-surface);margin:0}\n\n/* Installed-only Discover: search, concise filters, scannable rows. */\n.local-discovery-search-row{display:flex;align-items:center;gap:8px}\n#local-discover-search{flex:1;min-width:0;min-height:38px;font-size:13px;background:#fff;border-color:#cbd6e6}\n.local-discovery-import{flex:none;min-height:38px;background:#f0f4ff;color:#3156ad;border:1px solid #ccdafa;padding:7px 12px;font-size:12px;font-weight:700;border-radius:var(--radius-control)}\n.local-discovery-filters{display:flex;width:max-content;max-width:100%;flex-wrap:wrap;gap:2px;padding:3px;margin:8px 0 8px;background:#fff;border:1px solid var(--line);border-radius:var(--radius-surface)}\n.local-discovery-filters button{flex:none;min-height:32px;padding:5px 11px;background:transparent;color:#526783;border:1px solid transparent;border-radius:var(--radius-control);font-size:12px;font-weight:650}\n.local-discovery-filters button[aria-pressed=true]{background:#edf3ff;border-color:#c6d7f5;box-shadow:0 1px 2px #1c35600d;color:#2b52ab}\n.local-discovery-list{display:grid;gap:0;background:#fff;border:1px solid var(--line);border-radius:var(--radius-surface);overflow:hidden}\n.local-discovery-list:empty{display:none}\n.local-discovery-card{display:flex;align-items:center;text-align:left;gap:9px;width:100%;min-height:62px;padding:9px 10px!important;border:0!important;border-bottom:1px solid #edf0f5!important;border-radius:0!important;background:#fff!important;color:var(--ink)!important}\n.local-discovery-card:last-child{border-bottom:0!important}\n.local-discovery-card:hover{background:#f8faff!important}\n.local-discovery-card:focus-visible{position:relative;z-index:1;outline:2px solid var(--blue);outline-offset:-3px}\n.local-discovery-copy{flex:1;min-width:0;overflow-wrap:anywhere}\n.local-discovery-copy strong{display:block;font-size:13px;line-height:1.35}\n.local-discovery-copy small{display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;font-size:12px;line-height:1.4;color:#60728a;margin-top:3px}\n.local-discovery-state{background:#e9f5ee;color:#176f54}\n.local-discovery-state.other{background:#f1f4fa;color:#5b6f89}\n.local-discovery-state.off{background:#fbf1df;color:#825d21}\n.local-discovery-empty{padding:18px 12px;margin:0;color:#566c87;font-size:12px;line-height:1.6;text-align:center;overflow-wrap:anywhere}\n#local-discover-status:not(:empty){color:#a4424e;font-size:11px;margin:8px 0}\n#local-discover-status:empty{display:none}\n\n/* Develop: page signal and code first; results, library, DOM and SDK on demand. */\n/* R19: the parent owns 8px row spacing; descendants never stack unrelated margins.\n * Controls use '... 53613 more characters,
