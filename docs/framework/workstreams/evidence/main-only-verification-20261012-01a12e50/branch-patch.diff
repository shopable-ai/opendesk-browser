+.review .settings textarea{resize:vertical}
+.review .setting-row{display:flex;justify-content:space-between;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px;margin:9px 0}
+.review .setting-row div{min-width:0}
