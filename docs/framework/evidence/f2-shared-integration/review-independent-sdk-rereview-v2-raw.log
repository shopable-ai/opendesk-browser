class DetailEvent extends Event { constructor(type,{detail}) {super(type); this.detail=detail;} }
const window=new EventTarget(), timers=new Map(), callbacks=[], results=[]; let next=0;
const setTimer=(fn,ms)=>{const id=++next;timers.set(id,{fn,ms});return id;}, clearTimer=id=>timers.delete(id);
const options={window,CustomEvent:DetailEvent,setTimer,clearTimer};
const relay=installPageRelay({...options,api:{runtime:{sendMessage:(m,cb)=>callbacks.push({m,cb})}}});
window.addEventListener(SDK_READY_EVENT,e=>results.push(JSON.parse(e.detail)));
const page={window,CustomEvent:DetailEvent};
const sdk=installPageSdk({global:page,transport:createWindowTransport(options)});
const first=sdk.ready().then(x=>({ready:x}),e=>({error:e.code}));
