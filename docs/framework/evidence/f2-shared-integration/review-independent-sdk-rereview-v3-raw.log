function fixture(){
 const window=new EventTarget(),callbacks=[],timers=new Map(),readyEvents=[];let next=0;
 const options={window,CustomEvent:DetailEvent,setTimer:(fn,ms)=>{const id=++next;timers.set(id,{fn,ms});return id;},clearTimer:id=>timers.delete(id)};
 const relay=installPageRelay({...options,api:{runtime:{sendMessage:(m,cb)=>callbacks.push({m,cb})}}});
 const transport=createWindowTransport(options);
