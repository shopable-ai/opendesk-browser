{
  "name": "opendesk-browser",
  "version": "0.1.0",
  "private": true,
  "description": "OpenDesk Browser MV3 extension; stage 02A environment",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build.mjs production",
    "build:dev": "node scripts/build.mjs development",
    "pack": "node scripts/pack.mjs production",
    "pack:dev": "node scripts/pack.mjs development",
    "verify": "node scripts/verify-package.mjs dist/production && node scripts/verify-package.mjs dist/development",
    "check": "node scripts/check-source.mjs",
    "test": "node --test tests/environment/*.test.mjs"
  },
  "devDependencies": {
    "webpack": "5.95.0",
    "webpack-cli": "5.1.4",
    "terser-webpack-plugin": "5.3.10",
    "terser": "5.34.1"
  },
  "overrides": { "terser": "5.34.1" }
}
