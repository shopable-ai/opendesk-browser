          "data": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>OpenDesk Browser · 基础网页交互测试</title>\n<style>\n:root{font:14px/1.55 -apple-system,BlinkMacSystemFont,\"PingFang SC\",\"Microsoft YaHei\",system-ui,sans-serif;color:#19283d;background:#f7f9fc;font-synthesis:none}\n*{box-sizing:border-box}\nbody{margin:0}\nbutton,input,select{font:inherit}\nbutton{min-height:38px;cursor:pointer;border:1px solid #cbd5e1;border-radius:8px;padding:7px 13px;font-weight:600;color:#253854;background:#fff}\nbutton:hover{background:#f0f4fa}\nbutton:disabled{opacity:.52;cursor:not-allowed}\nbutton.primary{color:#fff;border-color:#2855bd;background:#2855bd}\nbutton.primary:hover{background:#2048a5}\nbutton.text-button{border:0;background:transparent;color:#51637c;padding-inline:7px}\n:focus-visible{outline:3px solid #86a7ef;outline-offset:2px}\n.topbar{background:white;border-bottom:1px solid #e0e6ee}\n.topbar-inner{max-width:760px;min-height:56px;margin:auto;padding:9px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px}\n.brand{display:flex;gap:9px;align-items:center;font-size:14px;font-weight:760}\n.brand-mark{width:27px;height:27px;display:grid;place-items:center;color:#fff;background:#2855bd;border-radius:8px;font-size:15px}\n.brand-note{font-size:12px;color:#596a82;font-weight:400}\nmain{max-width:760px;margin:27px auto 48px;padding:0 22px}\nh1{font-size:24px;letter-spacing:-.03em;line-height:1.3;margin:0 0 5px}\n.intro{margin:0 0 17px;color:#63748a;font-size:13px}\n.sheet{background:#fff;border:1px solid #e0e6ee;border-radius:12px;box-shadow:0 4px 18px #1b355108;overflow:hidden}\n.unit{padding:18px 22px 20px;min-width:0}\n.unit+.unit{border-top:1px solid #e8edf4}\n.unit-heading{display:flex;align-items:center;gap:11px;margin-bottom:10px}\n.unit-heading small{font-weight:750;color:#64748b;font-size:11px;font-variant-numeric:tabular-nums}\nh2{margin:0;font-size:14px;letter-spacing:-.01em;color:#203650}\nh3{margin:4px 0;font-size:18px;letter-spacing:-.025em}\n.sample-text{margin:0;color:#52647c}\n.chips{display:flex;flex-wrap:wrap;gap:6px;list-style:none;margin:12px 0 0;padding:0}\n.chips li{padding:3px 9px;background:#f3f6fa;border:1px solid #e7edf3;border-radius:6px;color:#5a6c83;font-size:12px}\n.controls{display:flex;align-items:center;flex-wrap:wrap;gap:8px}\n.result-line{margin:10px 0 0;font-size:13px;color:#516681}\n.result-line output{font-weight:800;color:#2855bd;font-variant-numeric:tabular-nums}\n.expanded{margin:10px 0 0;padding:10px 12px;border-radius:8px;background:#f3f7fc;color:#344d72;font-size:13px}\nlabel{font-size:12px;color:#445974;font-weight:650}\nselect,input{min-height:38px;min-width:0;color:#20324b;background:#fff;border:1px solid #cbd5e1;border-radius:8px;padding:7px 10px}\n#delay{width:118px}\n.status{display:flex;gap:8px;align-items:center;color:#61738b;margin-top:12px;font-size:13px}\n.indicator{width:7px;height:7px;flex:none;border-radius:50%;background:#a5b1c1}\n.status[data-state=\"loading\"] .indicator{background:#ca9137}\n.status[data-state=\"success\"] .indicator{background:#198767}\n.status[data-state=\"error\"] .indicator,.status[data-state=\"timeout\"] .indicator{background:#c24953}\n#async-result{margin:6px 0 0;color:#176546;font-size:13px}\n#async-result:empty{display:none}\n#async-error{color:#a83f4b}\n.fields{display:flex;flex-wrap:wrap;align-items:flex-end;gap:9px}\n.field{display:grid;gap:5px;flex:1;min-width:165px}\n.field input,.field select{width:100%}\n.feedback{margin:12px 0 0}\n#done{display:inline-block;margin:0;padding:8px 11px;border-radius:8px;background:#ecf8f0;color:#1b693c;font-weight:700}\n#form-hint{color:#b63a47;font-size:12px;margin:6px 0 0}\n#form-hint:empty,#form-result:empty{display:none}\n#search-form{display:flex;flex-wrap:wrap;align-items:flex-end;gap:10px}\n#search-status{font-size:13px;color:#176546;margin:10px 0 0}\n#results{font-size:13px;color:#344d70;margin-top:5px}\n#search-count{font-size:12px;color:#61728a;margin:6px 0 0}\n.footnote{font-size:12px;color:#5c6e85;margin:12px 0 0}\n.api-url-field{flex-basis:100%}\n#api-url{font:12px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}\n#api-preset{min-width:218px}\n.api-meta{display:flex;flex-wrap:wrap;gap:7px 16px;margin:10px 0 0;color:#586b82;font-size:12px}\n.api-meta div{display:flex;gap:5px;min-width:0}\n.api-meta dt{font-weight:750;white-space:nowrap}\n.api-meta dd{margin:0;overflow-wrap:anywhere}\n#api-post-fields[hidden]{display:none}\n#api-body{width:100%;min-width:0;resize:vertical;border:1px solid #cbd5e1;border-radius:8px;padding:8px;font:12px/1.5 monospace}\n#api-headers{white-space:pre-wrap;overflow-wrap:anywhere;font:12px/1.5 monospace}\n#api-response{margin:10px 0 0;max-height:200px;overflow:auto;background:#f6f8fb;border:1px solid #e1e8f1;border-radius:8px;padding:10px 12px;color:#243951;font:12px/1.6 ui-monospace,SFMono-Regular,Consolas,monospace;white-space:pre-wrap;overflow-wrap:anywhere}\n#api-error{margin:8px 0 0;color:#a83f4b;font-size:12px;overflow-wrap:anywhere}\n.status[data-state=\"cancelled\"] .indicator{background:#8998a9}\n\n@media(max-width:540px){.topbar-inner{padding:9px 15px}main{padding:0 13px;margin-top:23px}h1{font-size:22px}.unit{padding:16px}.field{flex-basis:100%}.controls{gap:7px}}\n</style>\n</head>\n<body>\n<header class=\"topbar\"><div class=\"topbar-inner\"><div class=\"brand\"><span class=\"brand-mark\" aria-hidden=\"true\">O</span>OpenDesk <span class=\"brand-note\">/ 测试网页</span></div><button id=\"reset-all\" type=\"button\" class=\"text-button\">重置页面</button></div></header>\n<main>\n  <h1>网页交互示例</h1>\n  <p class=\"intro\">读取文本、执行操作、等待异步结果、填写表单，并查看真实 HTTP 响应。</p>\n  <div class=\"sheet\">\n    <section class=\"unit\" aria-labelledby=\"text-title\">\n      <div class=\"unit-heading\"><small>01</small><h2 id=\"text-title\">文本读取</h2></div>\n      <h3 id=\"sample-title\" data-testid=\"sample-title\">周末阅读清单</h3>\n      <p id=\"sample-text\" class=\"sample-text\" data-testid=\"sample-text\">本周共有 3 项阅读计划，当前状态：等待开始。</p>\n      <ul id=\"sample-list\" class=\"chips\"><li>产品设计</li><li>浏览器技术</li><li>交互体验</li></ul>\n    </section>\n    <section class=\"unit\" aria-labelledby=\"click-title\">\n      <div class=\"unit-heading\"><small>02</small><h2 id=\"click-title\">按钮与 DOM 变化</h2></div>\n      <div class=\"controls\"><button id=\"click-button\" class=\"primary\" type=\"button\">点击一次</button><button id=\"toggle-button\" type=\"button\" aria-expanded=\"false\" aria-controls=\"extra-text\">展开文字</button></div>\n      <p class=\"result-line\">累计点击 <output id=\"click-count\" role=\"status\" aria-live=\"polite\">0</output> 次</p>\n      <p id=\"extra-text\" class=\"expanded\" hidden>这是点击后出现的文字，可用于验证元素显示和文本读取。</p>\n    </section>\n    <section class=\"unit\" aria-labelledby=\"async-title\">\n      <div class=\"unit-heading\"><small>03</small><h2 id=\"async-title\">网络请求与异步等待</h2></div>\n      <div class=\"controls\">\n        <label for=\"delay\">显示延迟</label>\n        <select id=\"delay\"><option value=\"300\">300 毫秒</option><option value=\"1200\" selected>1.2 秒</option><option value=\"3000\">3 秒</option></select>\n        <button id=\"request-success\" type=\"button\" class=\"primary\">请求成功</button>\n        <button id=\"request-failure\" type=\"button\">HTTP 404</button>\n        <button id=\"request-timeout\" type=\"button\">模拟超时</button>\n        <button id=\"request-cancel\" type=\"button\" class=\"text-button\" disabled>取消</button>\n      </div>\n      <div id=\"async-status\" class=\"status\" data-state=\"idle\" role=\"status\" aria-live=\"polite\"><span class=\"indicator\" aria-hidden=\"true\"></span><span id=\"async-status-text\">尚未发起请求</span></div>\n      <div id=\"async-result\" aria-live=\"polite\"></div>\n    </section>\n    <section class=\"unit\" aria-labelledby=\"form-title\">\n      <div class=\"unit-heading\"><small>04</small><h2 id=\"form-title\">简单表单</h2></div>\n      <form id=\"demo-form\" class=\"fields\" autocomplete=\"off\">\n        <div class=\"field\"><label for=\"name\">姓名</label><input id=\"name\" name=\"name\" type=\"text\" maxlength=\"40\" placeholder=\"例如 Alice\" required></div>\n        <div class=\"field\"><label for=\"topic\">咨询类型</label><select id=\"topic\" name=\"topic\"><option value=\"general\">一般问题</option><option value=\"feedback\">产品建议</option><option value=\"support\">技术支持</option></select></div>\n        <button id=\"submit\" type=\"submit\" class=\"primary\">提交</button>\n      </form>\n      <div id=\"form-result\" class=\"feedback\" role=\"status\" aria-live=\"polite\"></div>\n      <p id=\"form-hint\" role=\"alert\"></p>\n    </section>\n    <section class=\"unit\" aria-labelledby=\"modern-title\">\n      <div class=\"unit-heading\"><small>05</small><h2 id=\"modern-title\">动态搜索 · Locator 测试</h2></div>\n      <form id=\"search-form\" autocomplete=\"off\">\n        <div class=\"field\"><label for=\"keyword\">搜索关键词</label><input id=\"keyword\" name=\"keyword\" type=\"search\" value=\"旧的预填内容\"></div>\n        <button id=\"search-submit\" type=\"submit\">搜索</button>\n      </form>\n      <p id=\"search-status\" role=\"status\" hidden></p>\n      <div id=\"results\" aria-live=\"polite\"></div>\n      <p id=\"search-count\" aria-live=\"polite\">提交次数：0</p>\n    </section>\n    <section class=\"unit\" aria-labelledby=\"api-title\">\n      <div class=\"unit-heading\"><small>06</small><h2 id=\"api-title\">真实 HTTP · Fetch / SDK axiosx</h2></div>\n      <div class=\"fields\">\n        <div class=\"field api-url-field\">\n          <label for=\"api-url\">请求 URL</label>\n          <input id=\"api-url\" data-testid=\"api-url\" name=\"api-url\" type=\"text\" inputmode=\"url\" maxlength=\"600\" spellcheck=\"false\" value=\"./demo-form.html?test-response=1\" aria-describedby=\"api-tip\">\n        </div>\n        <div class=\"field\"><label for=\"api-channel\">请求通道</label><select id=\"api-channel\" data-testid=\"api-channel\"><option value=\"fetch\">网页 Fetch</option><option value=\"sdk\">OpenDesk SDK axiosx</option></select></div>\n        <div class=\"field\"><label for=\"api-method\">HTTP Method</label><select id=\"api-method\" data-testid=\"api-method\"><option>GET</option><option>POST</option></select></div>\n        <div class=\"field\"><label for=\"api-timeout\">超时 (ms)</label><input id=\"api-timeout\" data-testid=\"api-timeout\" type=\"number\" min=\"100\" max=\"30000\" step=\"100\" value=\"8000\"></div>\n        <div id=\"api-post-fields\" data-testid=\"api-post-fields\" class=\"field api-url-field\" hidden><label for=\"api-body\">POST JSON</label><textarea id=\"api-body\" data-testid=\"api-body\" rows=\"2\">{\"hello\":\"OpenDesk\"}</textarea></div>\n        <div class=\"field\">\n          <label for=\"api-preset\">示例地址（只填入，不发送）</label>\n          <select id=\"api-preset\" data-testid=\"api-preset\">\n            <option value=\"./demo-form.html?test-response=1\">本地同源 HTML · 无需外网</option>\n            <option value=\"./request-sample.json\">本地 JSON · 200</option>\n            <option value=\"./__opendesk_expected_404__.json\">本地不存在 · 404</option>\n            <option value=\"./__test__/echo\">POST 回显 · 辅助服务</option>\n            <option value=\"./__test__/status?code=429\">HTTP 429 · 辅助服务</option>\n            <option value=\"./__test__/status?code=500\">HTTP 500 · 辅助服务</option>\n            <option value=\"./__test__/delay?ms=1200\">真实延迟 · 辅助服务</option>\n            <option value=\"https://api.ipify.org?format=json\">公网 IP JSON · 第三方</option>\n          </select>\n        </div>\n        <div class=\"controls\">\n          <button id=\"api-send\" data-testid=\"api-send\" class=\"primary\" type=\"button\">发送 GET</button>\n          <button id=\"api-cancel\" data-testid=\"api-cancel\" type=\"button\" disabled>取消请求</button>\n        </div>\n      </div>\n      <p id=\"api-tip\" class=\"footnote\">仅点击发送才请求，不携带 Cookie。Fetch 跨源需要服务器 CORS；SDK 须先在扩展「独立网页 SDK」选择精确 document、批准 network 与目标 Origin 并安装。未安装不会回退 Fetch。SDK 不支持此页面的取消接口；切换或重置仅忽略迟到显示。公网 IP 示例需手动发送。</p>\n      <div id=\"api-status\" data-testid=\"api-status\" class=\"status\" data-state=\"idle\" role=\"status\" aria-live=\"polite\"><span class=\"indicator\" aria-hidden=\"true\"></span><span id=\"api-status-text\" data-testid=\"api-status-text\">尚未发送请求</span></div>\n      <dl class=\"api-meta\">\n        <div><dt>HTTP</dt><dd id=\"api-http-status\" data-testid=\"api-http-status\">—</dd></div>\n        <div><dt>耗时</dt><dd id=\"api-duration\" data-testid=\"api-duration\">—</dd></div>\n        <div><dt>响应类型</dt><dd id=\"api-content-type\" data-testid=\"api-content-type\">—</dd></div>\n      </dl>\n      <details><summary>响应 Headers</summary><pre id=\"api-headers\" data-testid=\"api-headers\"></pre></details>\n      <pre id=\"api-response\" data-testid=\"api-response\" aria-live=\"polite\" hidden></pre>\n      <p id=\"api-error\" data-testid=\"api-error\" role=\"alert\" hidden></p>\n    </section>\n  </div>\n  <p class=\"footnote\">第 03 组用真实同源 fetch 配合客户端模拟延迟/超时；第 06 组显示实际 HTTP 状态、耗时和响应正文。请通过本地 HTTP 服务打开，避免使用 file://。</p>\n</main>\n<script>\n(() => {\n  const get = id => document.getElementById(id);\n  let clicks = 0;\n  const extra = get('extra-text'), toggle = get('toggle-button');\n  get('click-button').addEventListener('click', () => {\n    get('click-count').textContent = String(++clicks);\n  });\n  toggle.addEventListener('click', () => {\n    extra.hidden = !extra.hidden;\n    toggle.setAttribute('aria-expanded', String(!extra.hidden));\n    toggle.textContent = extra.hidden ? '展开文字' : '收起文字';\n  });\n\n  // No external API is needed: Python's existing static server provides 200/404.\n  // Client-side display latency allows deterministic waits without server changes.\n  let activeRequest = null;\n  const requestCancel = get('request-cancel');\n  const asyncStatus = get('async-status'), asyncStatusText = get('async-status-text');\n  const asyncResult = get('async-result');\n  function showAsync(state, message, resultId = '', resultText = '') {\n    asyncStatus.dataset.state = state;\n    asyncStatusText.textContent = message;\n    asyncResult.replaceChildren();\n    if (resultId) {\n      const node = document.createElement('p');\n      node.id = resultId;\n      node.textContent = resultText;\n      asyncResult.append(node);\n    }\n  }\n  function abandonRequest() {\n    const previous = activeRequest;\n    activeRequest = null;\n    if (previous) previous.controller.abort();\n    requestCancel.disabled = true;\n  }\n  function sleep(ms, signal) {\n    return new Promise((resolve, reject) => {\n      if (signal.aborted) { reject(new DOMException('已中止', 'AbortError')); return; }\n      const timer = setTimeout(resolve, ms);\n      signal.addEventListener('abort', () => {\n        clearTimeout(timer);\n        reject(new DOMException('已中止', 'AbortError'));\n      }, {once:true});\n    });\n  }\n  async function runRequest(kind) {\n    abandonRequest();\n    const request = {controller: new AbortController(), timeoutTimer: null, reason: ''};\n    activeRequest = request;\n    requestCancel.disabled = false;\n    const selectedDelay = Number(get('delay').value);\n    const displayDelay = kind === 'timeout' ? Math.max(1500, selectedDelay) : selectedDelay;\n    if (kind === 'timeout') {\n      request.timeoutTimer = setTimeout(() => {\n        request.reason = 'timeout';\n        request.controller.abort();\n      }, 700);\n    }\n    showAsync('loading', '请求中…');\n    try {\n      const url = kind === 'error'\n        ? './__opendesk_expected_404__.json'\n        : './demo-form.html?test-response=1';\n      const response = await fetch(url, {cache:'no-store', signal:request.controller.signal});\n      await response.text();\n      await sleep(displayDelay, request.controller.signal);\n      if (activeRequest !== request) return;\n      if (!response.ok) throw new Error('HTTP ' + response.status);\n      showAsync('success', '请求成功', 'async-done', 'HTTP ' + response.status + ' · 已读取本地测试页面');\n    } catch (error) {\n      if (activeRequest !== request) return;  // Superseded or reset: no stale update.\n      if (request.reason === 'timeout') {\n        showAsync('timeout', '请求超时', 'async-error', 'E_TIMEOUT：模拟等待超过 700 毫秒');\n      } else if (request.controller.signal.aborted) {\n        showAsync('cancelled', '已取消');\n      } else {\n        showAsync('error', '请求失败', 'async-error', error instanceof Error ? error.message : String(error));\n      }\n    } finally {\n      if (request.timeoutTimer !== null) clearTimeout(request.timeoutTimer);\n      if (activeRequest === request) {\n        activeRequest = null;\n        requestCancel.disabled = true;\n      }\n    }\n  }\n  get('request-success').addEventListener('click', () => runRequest('success'));\n  get('request-failure').addEventListener('click', () => runRequest('error'));\n  get('request-timeout').addEventListener('click', () => runRequest('timeout'));\n  requestCancel.addEventListener('click', () => {\n    if (!activeRequest) return;\n    activeRequest.controller.abort();\n  });\n\n  const form = get('demo-form'), name = get('name');\n  name.addEventListener('input', () => {\n    get('form-hint').textContent = '';\n    get('done')?.remove();  // A new run must not mistake an old success for this submission.\n  });\n  form.addEventListener('invalid', event => {\n    if (event.target === name) get('form-hint').textContent = '请输入姓名';\n  }, true);\n  form.addEventListener('submit', event => {\n    event.preventDefault();\n    get('done')?.remove();\n    const value = name.value.trim();\n    if (!value) { get('form-hint').textContent = '请输入姓名'; return; }\n    const done = document.createElement('p');\n    done.id = 'done';\n    done.textContent = '已提交：' + value;\n    get('form-result').append(done);\n    get('form-hint').textContent = '';\n  });\n\n  // Preserve the modern Page API example's in-document replacement of #search-submit.\n  // This intentionally requires Locator re-query and disabled-button auto-waiting.\n  const searchForm = get('search-form'), keyword = get('keyword');\n  const searchStatus = get('search-status'), results = get('results');\n  let searchCount = 0, searchGeneration = 0;\n  keyword.addEventListener('input', () => {\n    const old = get('search-submit'), replacement = old.cloneNode(true);\n    replacement.disabled = true;\n    old.replaceWith(replacement);\n    const generation = ++searchGeneration;\n    setTimeout(() => { if (generation === searchGeneration) replacement.disabled = false; }, 180);\n    searchStatus.hidden = true;\n    results.textContent = '';\n  });\n  searchForm.addEventListener('submit', event => {\n    event.preventDefault();\n    get('search-count').textContent = '提交次数：' + ++searchCount;\n    const generation = ++searchGeneration;\n    const term = keyword.value;\n    setTimeout(() => {\n      if (generation !== searchGeneration) return;\n      searchStatus.textContent = '搜索完成';\n      searchStatus.hidden = false;\n      results.textContent = '结果：' + term;\n    }, 120);\n  });\n\n\n  // One HTTP form, with separate webpage Fetch and admitted MAIN SDK paths.\n  const apiUrl = get('api-url'), apiPreset = get('api-preset');\n  const apiSend = get('api-send'), apiCancel = get('api-cancel');\n  const apiChannel = get('api-channel'), apiMethod = get('api-method');\n  const apiTimeout = get('api-timeout'), apiBody = get('api-body');\n  const apiStatus = get('api-status'), apiStatusText = get('api-status-text');\n  const apiResponse = get('api-response'), apiError = get('api-error');\n  let activeApi = null;\n  function showApiStatus(state, message) {\n    apiStatus.dataset.state = state;\n    apiStatusText.textContent = message;\n  }\n  function clearApiView() {\n    showApiStatus('idle', '尚未发送请求');\n    get('api-http-status').textContent = '—';\n    get('api-duration').textContent = '—';\n    get('api-content-type').textContent = '—';\n    get('api-headers').textContent = '';\n    apiResponse.textContent = '';\n    apiResponse.hidden = true;\n    apiError.textContent = '';\n    apiError.hidden = true;\n  }\n  function abortApiRequest() {\n    const previous = activeApi;\n    activeApi = null;\n    if (previous) {\n      clearTimeout(previous.timer);\n      previous.controller?.abort(); // SDK has no AbortSignal facade.\n    }\n    apiSend.disabled = false;\n    apiCancel.disabled = true;\n  }\n  function showApiResponse(response) {\n    get('api-http-status').textContent = String(response.status) + (response.statusText ? ' ' + response.statusText : '');\n    const headers = response.headers || {};\n    get('api-content-type').textContent = headers['content-type'] || '（未提供）';\n    get('api-headers').textContent = JSON.stringify(headers, null, 2);\n    const body = typeof response.data === 'string' ? response.data : JSON.stringify(response.data, null, 2);\n    const bytes = new TextEncoder().encode(body ?? '');\n    apiResponse.textContent = new TextDecoder().decode(bytes.subarray(0, 4096)) + (bytes.length > 4096 ? '\\n…（预览已截断）' : '');\n    apiResponse.hidden = false;\n  }\n  async function readApiPreview(response) {\n    const limit = 4096;\n    const reader = response.body?.getReader();\n    if (!reader) {\n      const body = await response.text();\n      return {body:body.slice(0, limit), truncated:body.length > limit};\n    }\n    const decoder = new TextDecoder();\n    let body = '', bytes = 0;\n    try {\n      while (bytes < limit) {\n        const {done, value} = await reader.read();\n        if (done) return {body:body + decoder.decode(), truncated:false};\n        const part = value.subarray(0, Math.min(limit - bytes, value.byteLength));\n        body += decoder.decode(part, {stream:true});\n        bytes += part.byteLength;\n        if (part.byteLength < value.byteLength)\n          return {body:body + decoder.decode(), truncated:true};\n      }\n      return {body:body + decoder.decode(), truncated:true};\n    } finally {\n      await reader.cancel().catch(() => {});\n      reader.releaseLock();\n    }\n  }\n  async function runApiRequest() {\n    // A disabled send button plus this guard prevents duplicate in-flight calls.\n    if (activeApi) return;\n    clearApiView();\n    let url, data, timeout;\n    const channel = apiChannel.value, method = apiMethod.value;\n    try {\n      const input = apiUrl.value.trim();\n      if (!input) throw new TypeError('请输入请求 URL');\n      url = new URL(input, location.href);\n      if (!['http:', 'https:'].includes(url.protocol) || url.username || url.password)\n        throw new TypeError('仅支持不含账号密码的 HTTP(S) URL');\n      timeout = Number(apiTimeout.value);\n      if (!Number.isInteger(timeout) || timeout < 100 || timeout > 30000) throw new TypeError('超时须为 100–30000 ms 的整数');\n      if (method === 'POST') data = JSON.parse(apiBody.value);\n    } catch (error) {\n      showApiStatus('error', '请求参数无效');\n      apiError.hidden = false;\n      apiError.textContent = error.message;\n      return;\n    }\n    const request = {controller:channel === 'fetch' ? new AbortController() : null, timer:null, timedOut:false, started:performance.now()};\n    activeApi = request;\n    apiSend.disabled = true;\n    apiCancel.disabled = channel !== 'fetch';\n    showApiStatus('loading', '正在通过 ' + (channel === 'sdk' ? 'SDK axiosx' : 'Fetch') + ' 发送 ' + method + '…');\n    try {\n      if (channel === 'sdk') {\n        const sdk = window.OpenDeskSDK;\n        if (!sdk?.axiosx || typeof sdk.ready !== 'function') {\n          const error = new Error('未注入 OpenDesk SDK；请在扩展批准并安装到当前 document');\n          error.code = 'E_SDK_NOT_INSTALLED';\n          throw error;\n        }\n        await sdk.ready();\n        if (activeApi !== request) return;\n        const config = {timeout};\n        const response = method === 'POST'\n          ? await window.OpenDeskSDK.axiosx.post(url.href, data, config)\n          : await window.OpenDeskSDK.axiosx.get(url.href, config);\n        if (activeApi !== request) return;\n        showApiResponse(response);\n        showApiStatus('success', 'SDK axiosx · HTTP 请求完成');\n      } else {\n        request.timer = setTimeout(() => { request.timedOut = true; request.controller.abort(); }, timeout);\n        const response = await fetch(url.href, {method, credentials:'omit', mode:'cors', cache:'no-store',\n          ...(method === 'POST' ? {headers:{'content-type':'application/json'}, body:JSON.stringify(data)} : {}), signal:request.controller.signal});\n        const preview = await readApiPreview(response);\n        if (activeApi !== request || request.controller.signal.aborted) return;\n        const headers = {};\n        response.headers.forEach((value, name) => { headers[name] = value; });\n        showApiResponse({status:response.status, statusText:response.statusText, headers, data:preview.body});\n        if (preview.truncated) apiResponse.textContent += '\\n…（预览已截断）';\n        if (response.ok) showApiStatus('success', 'HTTP 请求完成');\n        else {\n          showApiStatus('error', 'HTTP 返回非成功状态');\n          apiError.textContent = 'E_HTTP: HTTP ' + response.status;\n          apiError.hidden = false;\n        }\n      }\n    } catch (error) {\n      if (activeApi !== request) return;\n      if (channel === 'sdk') {\n        const response = error.details?.response;\n        if (response) showApiResponse(response);\n        showApiStatus('error', 'SDK axiosx 请求失败');\n        apiError.textContent = (error.code || 'E_SDK') + ': ' + (error.message || String(error));\n      } else if (request.timedOut) {\n        showApiStatus('timeout', 'HTTP 请求超时');\n        apiError.textContent = 'E_TIMEOUT: ' + timeout + ' ms 内未完成响应';\n      } else if (request.controller.signal.aborted) {\n        showApiStatus('cancelled', '已取消请求');\n        apiError.textContent = 'E_CANCELLED: HTTP 请求已取消';\n      } else {\n        showApiStatus('error', 'HTTP 请求失败');\n        apiError.textContent = 'E_NETWORK: ' + (error.message || String(error)) + '（检查网络、服务地址或 CORS）';\n      }\n      apiError.hidden = false;\n    } finally {\n      clearTimeout(request.timer);\n      if (activeApi === request) {\n        get('api-duration').textContent = Math.round(performance.now() - request.started) + ' ms';\n        activeApi = null;\n        apiSend.disabled = false;\n        apiCancel.disabled = true;\n      }\n    }\n  }\n  apiSend.addEventListener('click', () => runApiRequest());\n  apiCancel.addEventListener('click', () => {\n    if (!activeApi?.controller) return;\n    activeApi.controller.abort();\n    showApiStatus('cancelled', '已取消请求');\n  });\n  apiPreset.addEventListener('change', () => {\n    abortApiRequest(); apiUrl.value = apiPreset.value; clearApiView();\n  });\n  for (const field of [apiUrl, apiTimeout, apiBody]) field.addEventListener('input', () => {\n    abortApiRequest(); apiPreset.selectedIndex = -1; clearApiView();\n  });\n  function updateApiOptions() {\n    abortApiRequest(); clearApiView();\n    get('api-post-fields').hidden = apiMethod.value !== 'POST';\n    apiSend.textContent = '发送 ' + apiMethod.value;\n  }\n  apiChannel.addEventListener('change', updateApiOptions);\n  apiMethod.addEventListener('change', updateApiOptions);\n  get('reset-all').addEventListener('click', () => {\n    abortApiRequest();\n    apiChannel.value = 'fetch'; apiMethod.value = 'GET'; apiTimeout.value = '8000'; apiBody.value = '{\"hello\":\"OpenDesk\"}';\n    get('api-post-fields').hidden = true; apiSend.textContent = '发送 GET';\n    apiUrl.value = './demo-form.html?test-response=1';\n    apiPreset.value = apiUrl.value;\n    clearApiView();\n    clicks = 0;\n    get('click-count').textContent = '0';\n    extra.hidden = true;\n    toggle.setAttribute('aria-expanded', 'false');\n    toggle.textContent = '展开文字';\n    abandonRequest();\n    showAsync('idle', '尚未发起请求');\n    get('delay').value = '1200';\n    form.reset();\n    get('done')?.remove();\n    get('form-hint').textContent = '';\n    ++searchGeneration;\n    searchCount = 0;\n    searchForm.reset();\n    get('search-submit').disabled = false;\n    get('search-count').textContent = '提交次数：0';\n    searchStatus.hidden = true;\n    searchStatus.textContent = '';\n    results.textContent = '';\n  });\n})();\n</script>\n</body>\n</html>\n",
