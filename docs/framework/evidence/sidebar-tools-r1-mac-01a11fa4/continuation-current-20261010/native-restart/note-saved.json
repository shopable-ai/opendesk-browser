        "css": ":root{font-family:system-ui,-apple-system,\"PingFang SC\",sans-serif;color:#25364e;background:#fff}\n*{box-sizing:border-box}body{margin:0}.notes-app{padding:14px;max-width:760px;margin:auto}\n.notes-heading{display:flex;align-items:flex-start;gap:12px;padding:10px 0 13px;border-bottom:1px solid #e7edf7}\n.notes-heading img{height:16px;width:16px;margin-top:7px}.notes-heading h1{font-size:19px;line-height:1.3;margin:0}\n.notes-heading p{font-size:12px;line-height:1.5;color:#60728d;margin:6px 0 0;overflow-wrap:anywhere}\nlabel{display:block;font-size:12px;font-weight:650;margin:17px 0 7px}\ntextarea,input{font:inherit;font-size:13px;width:100%;border:1px solid #cbd6e6;border-radius:9px;padding:10px}\ntextarea{resize:vertical;min-height:120px}\nbutton{border:1px solid #bdcff2;background:#edf3ff;color:#2f56af;border-radius:9px;font-size:12px;font-weight:650;padding:9px 11px;cursor:pointer}\nbutton:first-child{background:#315bd1;color:#fff}\n.actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:12px}#note-status{font-size:12px;color:#526585;line-height:1.5}\ndetails{border-top:1px solid #e7edf7;margin-top:14px;padding-top:10px;font-size:12px}summary{cursor:pointer;font-weight:650}\ndetails button{margin-top:9px}:focus-visible{outline:2px solid #315bd1;outline-offset:2px}\n\n",
        "description": "在独立侧栏里保存笔记并读取当前页面标题，不自动操作网站。",
        "format": "opendesk.sidebar-tool.v1",
        "html": "<main class=\"notes-app\">\n  <header class=\"notes-heading\"><img src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAusB9WlD2NwAAAAASUVORK5CYII=\" width=\"16\" height=\"16\" alt=\"\">\n    <div><h1>网页笔记</h1><p id=\"page-summary\">读取当前网页…</p></div></header>\n  <label for=\"note-text\">我的笔记</label>\n  <textarea id=\"note-text\" rows=\"7\" placeholder=\"记录当前网页的重点…\"></textarea>\n  <div class=\"actions\"><button id=\"save-note\" type=\"button\">保存笔记</button><button id=\"refresh-page\" type=\"button\">更新网页信息</button></div>\n  <p id=\"note-status\" role=\"status\" aria-live=\"polite\">仅保存在本机的此工具内。</p>\n  <details><summary>打开已安装的自动化任务</summary>\n    <label for=\"task-name\">任务 ID</label><input id=\"task-name\" placeholder=\"输入已安装任务 ID\">\n    <button id=\"open-task\" type=\"button\">前往任务（不会自动运行）</button>\n  </details>\n</main>\n",
        "id": "quick-notes",
        "js": "(() => {\n  'use strict';\n  const {root,request}=globalThis.OpenDeskTool;\n  const el=id=>root.querySelector('#'+id);\n  const show=message=>{el('note-status').textContent=message;};\n  async function refreshPage() {\n    try {\n      const page=await request('currentPage.info');\n      el('page-summary').textContent=page.status==='available'?\n        page.title+' · '+page.url:'当前网页不可用：'+page.message;\n    }catch(error){el('page-summary').textContent=error.message;}\n  }\n  async function restore() {\n    try{const result=await request('storage.get',{key:'note'});el('note-text').value=String(result.value||'');}\n    catch(error){show('恢复笔记失败：'+error.message);}\n  }\n  el('refresh-page').addEventListener('click',()=>void refreshPage());\n  el('save-note').addEventListener('click',async()=>{\n    try{await request('storage.set',{key:'note',value:el('note-text').value});show('笔记已保存到此工具的本地存储');}\n    catch(error){show('保存失败：'+error.message);}\n  });\n  el('open-task').addEventListener('click',async()=>{\n    try{await request('tasks.open',{taskId:el('task-name').value.trim()});}\n    catch(error){show('打开任务失败：'+error.message);}\n  });\n  void Promise.all([refreshPage(),restore()]);\n})();\n",
        "title": "网页笔记",
        "version": "1.0.0"
      }
    ]
  },
