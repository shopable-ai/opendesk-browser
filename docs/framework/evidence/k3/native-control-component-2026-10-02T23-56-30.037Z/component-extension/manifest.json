{
  "manifest_version": 3,
  "name": "K3 product-module targeted proof",
  "version": "1.0.0",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "sandbox": {
    "pages": [
      "src/scripting/sandbox/sandbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; worker-src blob:; connect-src 'none'; child-src 'none'; img-src 'none'; style-src 'none'; base-uri 'none'; form-action 'none'"
  }
}