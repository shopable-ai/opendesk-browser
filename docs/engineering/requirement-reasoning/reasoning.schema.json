{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:opendesk:engineering:requirement-reasoning:r2",
  "title": "Requirement reasoning R2",
  "oneOf": [
    {
      "$ref": "#/$defs/input"
    },
    {
      "$ref": "#/$defs/output"
    }
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "kind": {
          "enum": [
            "USER_QUOTE",
            "REPOSITORY",
            "RESEARCH",
            "OBSERVATION",
            "RECONSTRUCTED",
            "UNAVAILABLE"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "kind",
        "locator",
        "revision",
        "note"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "enum": [
            "INTENT",
            "PROBLEM",
            "GOAL",
            "REQUIREMENT",
            "FEATURE",
            "SCENARIO",
            "CONSTRAINT",
            "ASSUMPTION",
            "OBSTACLE",
            "SOLUTION",
            "DECISION",
            "TASK",
            "ACCEPTANCE",
            "EVIDENCE"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "EXTRACT",
            "RESTORE",
            "DECOMPOSE",
            "EXPAND",
            "JOURNEY",
            "REVERSE",
            "OBSTACLE",
            "DEPENDENCY",
            "CONFLICT",
            "DISCOVER",
            "PRUNE_VERIFY"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "provenance": {
          "enum": [
            "USER_CONFIRMED",
            "SOURCE_VERIFIED",
            "AI_INFERRED",
            "NEEDS_DECISION",
            "OUT_OF_SCOPE"
          ]
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "scope": {
          "enum": [
            "IN_SCOPE",
            "DEFERRED",
            "OUT_OF_SCOPE"
          ]
        },
        "reviewState": {
          "enum": [
            "PROPOSED",
            "APPROVED",
            "NEEDS_DECISION",
            "REJECTED",
            "RETIRED"
          ]
        },
        "risk": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "verificationState": {
          "enum": [
            "NOT_TESTED",
            "BLOCKED",
            "FAIL",
            "PASS",
            "STALE"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requirementCategory": {
              "enum": [
                "FUNCTIONAL",
                "QUALITY",
                "CONSTRAINT"
              ]
            },
            "actor": {
              "type": "string",
              "minLength": 1
            },
            "precondition": {
              "type": "string",
              "minLength": 1
            },
            "trigger": {
              "type": "string",
              "minLength": 1
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "recovery": {
              "type": "string",
              "minLength": 1
            },
            "method": {
              "type": "string",
              "minLength": 1
            },
            "expected": {
              "type": "string",
              "minLength": 1
            },
            "candidate": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "observed": {
              "type": "string",
              "minLength": 1
            },
            "validation": {
              "type": "string",
              "minLength": 1
            },
            "input": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "string",
              "minLength": 1
            },
            "authorization": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": []
        }
      },
      "required": [
        "id",
        "type",
        "statement",
        "operator",
        "rationale",
        "sourceIds",
        "provenance",
        "confidence",
        "priority",
        "scope",
        "reviewState",
        "risk",
        "verificationState",
        "owner",
        "detail"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "REQUIREMENT"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "requirementCategory"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "SCENARIO"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "actor",
                  "precondition",
                  "trigger",
                  "outcome",
                  "recovery"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ACCEPTANCE"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "method",
                  "expected"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "EVIDENCE"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "candidate",
                  "environment",
                  "observed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ASSUMPTION"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "validation"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "TASK"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "input",
                  "output"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "DECISION"
              }
            }
          },
          "then": {
            "properties": {
              "detail": {
                "required": [
                  "authorization"
                ]
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "type": {
          "enum": [
            "DERIVED_FROM",
            "DEPENDS_ON",
            "CONFLICTS_WITH",
            "SATISFIES",
            "EXERCISES",
            "VERIFIED_BY",
            "CHECKS_SCENARIO",
            "IMPLEMENTED_BY",
            "CONSTRAINS",
            "OBSTRUCTS",
            "ADDRESSES",
            "RESOLVES",
            "SUPPORTED_BY"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "resolutionDecisionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "from",
        "to",
        "type",
        "rationale"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true,
          "minItems": 2
        },
        "logic": {
          "enum": [
            "AND",
            "OR",
            "XOR"
          ]
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "uniqueItems": true
        },
        "state": {
          "enum": [
            "OPEN",
            "RESOLVED"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "parent",
        "members",
        "logic",
        "selected",
        "state",
        "rationale"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      },
      "required": [
        "nodes",
        "edges",
        "groups"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "goal",
        "phase",
        "excluded"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 1
        },
        "stableRounds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxDepth",
        "maxNodes",
        "maxRounds",
        "stableRounds"
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "input"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "rawIntent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "enum": [
                "VERBATIM",
                "RECONSTRUCTED",
                "UNAVAILABLE"
              ]
            },
            "sourceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "required": [
            "text",
            "status",
            "sourceId"
          ]
        },
        "priorGraph": {
          "$ref": "#/$defs/graph"
        },
        "change": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "runId",
        "projectId",
        "baselineRevision",
        "sources",
        "scope",
        "budget",
        "rawIntent"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "output"
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          },
          "minItems": 1
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "graphRevision": {
          "type": "string",
          "minLength": 1
        },
        "graph": {
          "$ref": "#/$defs/graph"
        },
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reason": {
              "enum": [
                "FIXPOINT",
                "BUDGET_EXHAUSTED",
                "SOURCE_UNAVAILABLE",
                "USER_BOUNDARY",
                "BLOCKED",
                "DESK_EXAMPLE"
              ]
            },
            "rounds": {
              "type": "integer",
              "minimum": 0
            },
            "frontier": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "uniqueItems": true
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reason",
            "rounds",
            "frontier",
            "note"
          ]
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "DESIGN",
                "REVIEW_REQUIRED",
                "BLOCKED",
                "APPROVED"
              ]
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "nextAction": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status",
            "blockers",
            "nextAction"
          ]
        },
        "delta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "added": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "uniqueItems": true
            },
            "changed": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "uniqueItems": true
            },
            "retired": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "uniqueItems": true
            },
            "affected": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "added",
            "changed",
            "retired",
            "affected"
          ]
        },
        "review": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dimension": {
                "enum": [
                  "REQUIREMENTS",
                  "PRODUCT",
                  "ARCHITECTURE",
                  "AGENT",
                  "TEST",
                  "RED_TEAM"
                ]
              },
              "status": {
                "enum": [
                  "NOT_SCORED",
                  "DESK_REVIEW",
                  "INDEPENDENT_SCORED"
                ]
              },
              "score": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "dimension",
              "status",
              "score",
              "evidence"
            ]
          }
        }
      },
      "required": [
        "kind",
        "runId",
        "projectId",
        "baselineRevision",
        "sources",
        "scope",
        "budget",
        "graphRevision",
        "graph",
        "stop",
        "gate",
        "delta",
        "review"
      ]
    }
  }
}
