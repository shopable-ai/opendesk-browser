{
  "name": "scrapyjs",
  "description": "> 原则：简单使用，简化重复代码。罗列出不同变化频率的变量。包含导出文件格式，",
  "version": "1.0.0",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "directories": {
    "test": "test"
  },
  "scripts": {
    "lint": "node test/lint.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:check": "npm pack --dry-run",
    "build": "webpack --config webpack.config.js",
    "gulp": "gulp scripts"
  },
  "dependencies": {
    "ansi-regex": "^2.1.1",
    "ansi-styles": "^2.2.1",
    "axios": "^1.8.2",
    "camelcase": "^2.1.1",
    "chalk": "^1.1.3",
    "cheerio": "^1.0.0",
    "cliui": "^3.2.0",
    "code-point-at": "^1.1.0",
    "commander": "^2.20.3",
    "concat": "^1.0.3",
    "decamelize": "^1.2.0",
    "escape-string-regexp": "^1.0.5",
    "has-ansi": "^2.0.0",
    "invert-kv": "^1.0.0",
    "is-fullwidth-code-point": "^1.0.0",
    "lcid": "^1.0.0",
    "number-is-nan": "^1.0.1",
    "os-locale": "^1.4.0",
    "string-width": "^1.0.2",
    "strip-ansi": "^3.0.1",
    "supports-color": "^2.0.0",
    "window-size": "^0.1.4",
    "wrap-ansi": "^2.1.0",
    "y18n": "^3.2.2",
    "yargs": "^3.32.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "concat-cli": "^4.0.0",
    "gulp": "^5.0.0",
    "gulp-concat": "^2.6.1",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^4.1.4",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
