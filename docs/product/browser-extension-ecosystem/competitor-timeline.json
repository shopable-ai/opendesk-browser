  "fieldSemantics": {
    "firstReleasedAt": "First public release date of product (unknown unless individually researched); NOT a claim of first feature.",
    "latestStableAt": "Publication date of independently confirmed stable release; null if not confirmed.",
    "latestPreviewAt": "Publication date of independently confirmed beta/pre-release; never silently promote to stable.",
    "lastSourceActivityAt": "GitHub pushed_at from repository API (UTC); not release date or evidence of feature readiness.",
    "lastStoreUpdatedAt": "Independent browser-store timestamp; not filled from GitHub release or source activity.",
    "lastVerifiedAt": "Date of checking referenced sources; evidence can expire.",
    "maintenanceAssessment": "ACTIVE_SOURCE / ACTIVE_RELEASE / SLOW_RELEASE_CYCLE / UNKNOWN; not a conclusion that a project is dead."
  },
  "reviewRules": {
    "requireDateAndChannelForFeatureFirst": true,
    "after180DaysWithoutKnownStableRelease": "FOLLOWUP_VERIFY—check store, docs, beta, and product activity; do not assume abandoned.",
    "after365DaysWithoutEvidence": "PRIORITY_REVIEW—still do not mark DEAD without authoritative evidence.",
    "comparisonsMustCheck": "same browser, channel (stable/beta), published package, functionality, permission, and reproducible task",
    "recheckCadence": "monthly for core rivals; within 7 days before marketing launch; immediately when disproving counterexample appears"
  },
