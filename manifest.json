{
  "manifest_version": 3,
  "name": "GrayDove",
  "short_name": "GrayDove",
  "version": "2.0.0",
  "version_name": "v2",
  "description": "Reduce repetitive web work with installed browser automation tasks, and customize websites with JavaScript.",
  "minimum_chrome_version": "138",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "activeTab",
    "downloads",
    "tabs",
    "webNavigation",
    "debugger",
    "userScripts",
    "cookies",
    "notifications",
    "unlimitedStorage",
    "alarms",
    "offscreen",
    "proxy",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "bookmarks",
    "history",
    "contextMenus",
    "clipboardWrite",
    "webRequest",
    "nativeMessaging",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/graydove-16.png",
    "20": "icons/graydove-20.png",
    "24": "icons/graydove-24.png",
    "32": "icons/graydove-32.png",
    "48": "icons/graydove-48.png",
    "128": "icons/graydove-128.png"
  },
  "action": {
    "default_title": "打开侧边栏",
    "default_icon": {
      "16": "icons/graydove-16.png",
      "20": "icons/graydove-20.png",
      "24": "icons/graydove-24.png",
      "32": "icons/graydove-32.png",
      "48": "icons/graydove-48.png",
      "128": "icons/graydove-128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval' blob:; worker-src blob:; connect-src 'none'; child-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'"
  },
  "incognito": "not_allowed",
  "sandbox": {
    "pages": [
      "scripting/sandbox/sandbox.html",
      "sidebar-tools/sandbox.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "framework/sdk-main.js"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "stay-focus/blocked-quota.html",
        "stay-focus/blocked-schedule.html",
        "stay-focus/blocked-session.html",
        "stay-focus/blocked-always.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "resources": [
        "managed-site/blocked-quota.html",
        "managed-site/blocked-schedule.html",
        "managed-site/blocked-session.html",
        "managed-site/blocked-always.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "native-agent/settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "agents/chatgpt-fixed-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chat.deepseek.com/a/chat/s/*",
        "https://chat.deepseek.com/"
      ],
      "js": [
        "agents/gemini-fixed-send-queue.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "agents/page-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "framework/sdk-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
